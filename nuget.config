<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="liquidglass-prototype" value="src/Capacitor.App/Prototypes/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="liquidglass-prototype"><package pattern="LiquidGlassAvaloniaUI" /></packageSource>
  </packageSourceMapping>
</configuration>
