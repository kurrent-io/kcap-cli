<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             x:Class="Capacitor.App.App"
             Name="kcap"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <!-- The app palette. Kcap-prefixed keys never shadow a FluentTheme resource. ThemeVariant
             is Dark because every Kcap* brush is a dark-canvas token: Fluent's light
             ButtonBackgroundPointerOver would paint a near-white fill under our light Foreground
             and the control vanishes on hover. -->
        <ResourceDictionary>
            <SolidColorBrush x:Key="KcapCanvasBrush" Color="#0B0D12" />
            <SolidColorBrush x:Key="KcapSurfaceBrush" Color="#12151D" />
            <SolidColorBrush x:Key="KcapSurfaceRaisedBrush" Color="#191D27" />
            <SolidColorBrush x:Key="KcapBorderBrush" Color="#2A3040" />
            <!-- A rule that must read where content already carries Border-coloured chrome. -->
            <SolidColorBrush x:Key="KcapBorderStrongBrush" Color="#414A5E" />
            <SolidColorBrush x:Key="KcapTextBrush" Color="#F1F3F7" />
            <!-- Secondary / tertiary body text: both clear AA (≥4.5:1) on Canvas→Border. -->
            <SolidColorBrush x:Key="KcapMutedBrush" Color="#B0B7C6" />
            <SolidColorBrush x:Key="KcapFaintBrush" Color="#949BAA" />
            <!-- Primary CTAs stay on the light ramp. Hover lifts toward white and press steps
                 to a light off-white; a text grey as the fill drops the near-black label's contrast.
                 Green is status only; a selection uses info blue. -->
            <SolidColorBrush x:Key="KcapPrimaryBrush" Color="#F1F3F7" />
            <SolidColorBrush x:Key="KcapPrimaryHoverBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="KcapPrimaryPressedBrush" Color="#E4E7EE" />
            <SolidColorBrush x:Key="KcapOnPrimaryBrush" Color="#0B0D12" />
            <SolidColorBrush x:Key="KcapSuccessBrush" Color="#5BE0B3" />
            <SolidColorBrush x:Key="KcapSuccessDimBrush" Color="#173F36" />
            <SolidColorBrush x:Key="KcapWarningBrush" Color="#F4B860" />
            <SolidColorBrush x:Key="KcapWarningDimBrush" Color="#45351E" />
            <SolidColorBrush x:Key="KcapPurpleBrush" Color="#A994FF" />
            <SolidColorBrush x:Key="KcapPurpleDimBrush" Color="#29233E" />
            <SolidColorBrush x:Key="KcapDangerBrush" Color="#FF7272" />
            <SolidColorBrush x:Key="KcapDangerDimBrush" Color="#321F29" />
            <SolidColorBrush x:Key="KcapInfoBrush" Color="#7BA7F7" />
            <SolidColorBrush x:Key="KcapInfoDimBrush" Color="#1B2740" />
            <SolidColorBrush x:Key="KcapSelectionBrush" Color="#1E2E52" />
            <Color x:Key="ScrollBarThumbBackgroundColor">#3A66B8</Color>
            <Color x:Key="ScrollBarPanningThumbBackgroundColor">#3A66B8</Color>
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#3A66B8" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#5989E3" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#7BA7F7" />
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#00000000" />
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#1B2740" />
            <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#00000000" />
            <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="#1E2E52" />
            <SolidColorBrush x:Key="ScrollBarBackground" Color="#00000000" />
            <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="#00000000" />
            <SolidColorBrush x:Key="ScrollBarButtonBackground" Color="#00000000" />
            <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="#00000000" />
            <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="#00000000" />
            <SolidColorBrush x:Key="ScrollViewerScrollBarsSeparatorBackground" Color="#00000000" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://kcap-desktop/Views/PendingCardTemplates.axaml" />
                <ResourceInclude Source="avares://kcap-desktop/Views/Onboarding/OnboardingResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://MarkView.Avalonia/Themes/MarkdownTheme.axaml" />
        <StyleInclude Source="avares://kcap-desktop/Views/MarkdownStyles.axaml" />
        <StyleInclude Source="avares://kcap-desktop/Views/PullRequestStyles.axaml" />
        <StyleInclude Source="avares://kcap-desktop/Views/ChatBubbleStyles.axaml" />
        <StyleInclude Source="avares://kcap-desktop/Views/Onboarding/OnboardingStyles.axaml" />
        <!-- Popup panels drawn on our tokens: the flyout presenter IS the panel (no inner Border
             fighting the theme's own chrome). Opted into per flyout via FlyoutPresenterClasses.
             Fluent's ControlTheme defaults ScrollViewer.HorizontalScrollBarVisibility=Auto on the
             presenter's OWN ScrollViewer — that is the horizontal bar on Activity, not the inner
             one. Content that needs to scroll owns its own ScrollViewer. -->
        <Style Selector="FlyoutPresenter.kcapPanel">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MaxWidth" Value="10000" />
            <Setter Property="MaxHeight" Value="10000" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <!-- A MenuFlyout presents through MenuFlyoutPresenter, which is not a FlyoutPresenter, so
             the same class needs its own arm or the flyout silently keeps the theme's chrome. -->
        <Style Selector="MenuFlyoutPresenter.kcapPanel">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="MaxWidth" Value="10000" />
            <Setter Property="MaxHeight" Value="10000" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="ContextFlyout" Value="{x:Static views:TextContextMenu.ForTextBox}" />
        </Style>
        <!-- Fluent sets its menu under [IsEnabled=True], and a triggered style outranks a plain one. -->
        <Style Selector="SelectableTextBlock[IsEnabled=True]">
            <Setter Property="ContextFlyout" Value="{x:Static views:TextContextMenu.ForSelectableTextBlock}" />
        </Style>
        <!-- A TextBox inside one of our cards: the card is its boundary, so the theme's focused
             ring and fill would read as a second box. Fluent's default placeholder follows the
             system theme and goes near-black on our dark surfaces — pin a readable muted tone.
             Line box matches markdown body (15 / 24) so typed text and sent bubbles share a
             rhythm; a hair of tracking keeps wrapped lines from reading as a solid block. -->
        <Style Selector="TextBox.kcapEmbedded">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="PlaceholderForeground" Value="{StaticResource KcapMutedBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="LetterSpacing" Value="0.2" />
        </Style>
        <Style Selector="TextBox.kcapEmbedded /template/ Border#PART_BorderElement,
                         TextBox.kcapEmbedded:focus /template/ Border#PART_BorderElement,
                         TextBox.kcapEmbedded:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- Standalone fields (Settings, setup, sign-in prompts): pin the Fluent ring to our
             tokens. Fluent paints PART_BorderElement from TextControlBorderBrush, which reads as
             a second white box on kcap surfaces. -->
        <Style Selector="TextBox.kcapField">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="LetterSpacing" Value="0.1" />
            <Setter Property="PlaceholderForeground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="TextBox.kcapField /template/ Border#PART_BorderElement,
                         TextBox.kcapField:focus /template/ Border#PART_BorderElement,
                         TextBox.kcapField:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <!-- A button drawn as a field: it opens a surface rather than taking text. -->
        <Style Selector="Button.kcapField">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.kcapField /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
        </Style>
        <Style Selector="Button.kcapField:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.kcapField:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderStrongBrush}" />
        </Style>
        <Style Selector="NumericUpDown.kcapField">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="ShowButtonSpinner" Value="False" />
            <Setter Property="PlaceholderForeground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="NumericUpDown.kcapField /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement,
                         NumericUpDown.kcapField /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox.kcapField">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="MaxDropDownHeight" Value="280" />
        </Style>
        <Style Selector="ComboBox.kcapField /template/ Border#Background,
                         ComboBox.kcapField:pointerover /template/ Border#Background,
                         ComboBox.kcapField:pressed /template/ Border#Background,
                         ComboBox.kcapField:focus /template/ Border#Background">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ComboBox.kcapField /template/ Border#HighlightBackground">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox.kcapField /template/ Border#PopupBorder">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ComboBox.kcapField /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <!-- Popup items live under the ComboBox logically; Fluent's selected fill is the
             accent blue and would otherwise ignore KcapField chrome. -->
        <Style Selector="ComboBox.kcapField ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.kcapField ComboBoxItem /template/ ContentPresenter,
                         ComboBox.kcapField ComboBoxItem:pointerover /template/ ContentPresenter,
                         ComboBox.kcapField ComboBoxItem:pressed /template/ ContentPresenter,
                         ComboBox.kcapField ComboBoxItem:selected /template/ ContentPresenter,
                         ComboBox.kcapField ComboBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="ComboBox.kcapField ComboBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ComboBox.kcapField ComboBoxItem:pointerover /template/ ContentPresenter,
                         ComboBox.kcapField ComboBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
        </Style>
        <Style Selector="ComboBox.kcapField ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapBorderBrush}" />
        </Style>
        <Style Selector="TabControl.kcapSettingsTabs">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TabItem.kcapSettingsTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <!-- Six tabs at the default text size fit one row of the fixed-width Settings window. -->
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="TabItem.kcapSettingsTab /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TabItem.kcapSettingsTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="TabItem.kcapSettingsTab:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSelectionBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapInfoBrush}" />
        </Style>
        <Style Selector="TabItem.kcapSettingsTab:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{StaticResource KcapInfoBrush}" />
        </Style>
        <Style Selector="ToggleSwitch.kcapSwitch">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ToggleSwitch">
                    <Grid Width="44" Height="24" VerticalAlignment="Center"
                          Background="{TemplateBinding Background}"
                          TemplatedControl.IsTemplateFocusTarget="True">
                        <Border Name="SwitchTrack" CornerRadius="12"
                                Background="{StaticResource KcapSurfaceRaisedBrush}"
                                BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="1" />
                        <Canvas Name="PART_SwitchKnob" Width="22" Height="24" HorizontalAlignment="Left">
                            <Grid Name="PART_MovingKnobs" Width="22" Height="24">
                                <Border Name="SwitchThumb" Width="18" Height="18"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="9"
                                        Background="{StaticResource KcapMutedBrush}" />
                            </Grid>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleSwitch.kcapSwitch:pointerover /template/ Border#SwitchTrack">
            <Setter Property="BorderBrush" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="ToggleSwitch.kcapSwitch:focus-visible /template/ Border#SwitchTrack">
            <Setter Property="BorderBrush" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ToggleSwitch.kcapSwitch:checked /template/ Border#SwitchTrack">
            <Setter Property="Background" Value="{StaticResource KcapInfoDimBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapInfoBrush}" />
        </Style>
        <Style Selector="ToggleSwitch.kcapSwitch:checked /template/ Border#SwitchThumb">
            <Setter Property="Background" Value="{StaticResource KcapInfoBrush}" />
        </Style>
        <Style Selector="ToggleSwitch.kcapSwitch:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <!-- Fluent's radio/check glyphs use the system accent (a bright blue on our canvas). -->
        <Style Selector="RadioButton /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="RadioButton /template/ Ellipse#CheckOuterEllipse,
                         RadioButton:pointerover /template/ Ellipse#CheckOuterEllipse,
                         RadioButton:pressed /template/ Ellipse#CheckOuterEllipse,
                         RadioButton:checked /template/ Ellipse#CheckOuterEllipse,
                         RadioButton:checked:pointerover /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Fill" Value="{StaticResource KcapPrimaryBrush}" />
            <Setter Property="Stroke" Value="{StaticResource KcapPrimaryBrush}" />
        </Style>
        <Style Selector="RadioButton /template/ Ellipse#CheckGlyph,
                         RadioButton:pointerover /template/ Ellipse#CheckGlyph,
                         RadioButton:pressed /template/ Ellipse#CheckGlyph,
                         RadioButton:checked /template/ Ellipse#CheckGlyph">
            <Setter Property="Fill" Value="{StaticResource KcapOnPrimaryBrush}" />
            <Setter Property="Stroke" Value="{StaticResource KcapOnPrimaryBrush}" />
        </Style>
        <Style Selector="CheckBox /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle,
                         CheckBox:checked:pointerover /template/ Border#NormalRectangle,
                         CheckBox:checked:pressed /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{StaticResource KcapPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapPrimaryBrush}" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph,
                         CheckBox:checked:pointerover /template/ Path#CheckGlyph,
                         CheckBox:checked:pressed /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="{StaticResource KcapOnPrimaryBrush}" />
        </Style>
        <Style Selector="ListBox.kcapList">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="TextBlock.kcapTitle">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="28" />
            <Setter Property="LetterSpacing" Value="-0.3" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="TextBlock.kcapSubtitle">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="LetterSpacing" Value="0.2" />
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.kcapLabel">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="TextBlock.kcapHint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="LetterSpacing" Value="0.2" />
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <!-- Two-line tooltips: extra info is the default (lighter) line; this caption under it
             names the fragment. Solo captions stay unclassed so they match a one-line tip. -->
        <Style Selector="TextBlock.kcapTipCaption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Fluent paints hover/pressed on PART_ContentPresenter, not the Button.Background local
             value — so a chip that sets its own fill still gets a theme fill that clashes with
             KcapTextBrush. These classes pin the template chrome to our tokens (same footgun
             SessionRail.railRow already calls out). -->
        <Style Selector="Button.kcapChip">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.kcapChip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.kcapChip:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.kcapChip:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.kcapChip:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
        </Style>
        <!-- A link inside a line of text, coloured like a chat link. -->
        <Style Selector="Button.kcapLink">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource KcapInfoBrush}" />
        </Style>
        <Style Selector="Button.kcapLink /template/ ContentPresenter#PART_ContentPresenter,
                         Button.kcapLink:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.kcapLink:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapInfoBrush}" />
        </Style>
        <Style Selector="Button.kcapLink TextBlock">
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
        <!-- The chip look on a radio. Fluent draws an ellipse glyph beside the content, so this is a
             template swap rather than setters; the presenter is deliberately not named
             PART_ContentPresenter, which keeps Fluent's per-state presenter styles off the chip. -->
        <Style Selector="RadioButton.kcapChoice">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="ChipContent" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.kcapChoice:pointerover">
            <Setter Property="Background" Value="{StaticResource KcapBorderBrush}" />
        </Style>
        <Style Selector="RadioButton.kcapChoice:checked,
                         RadioButton.kcapChoice:checked:pointerover">
            <Setter Property="Background" Value="{StaticResource KcapPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapOnPrimaryBrush}" />
        </Style>
        <!-- Dimming the whole chip rather than its brushes keeps the checked one legible while a
             send holds the form. -->
        <Style Selector="RadioButton.kcapChoice:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.kcapPrimary">
            <Setter Property="Background" Value="{StaticResource KcapPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapOnPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.kcapPrimary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapPrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapOnPrimaryBrush}" />
        </Style>
        <Style Selector="Button.kcapPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapPrimaryHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapPrimaryHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapOnPrimaryBrush}" />
        </Style>
        <Style Selector="Button.kcapPrimary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapPrimaryPressedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapPrimaryPressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapOnPrimaryBrush}" />
        </Style>
        <Style Selector="Button.kcapPrimary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
        </Style>
        <!-- Ghost rows (picker lists, help flyout): Fluent paints the presenter, so rest and hover
             both have to pin it — otherwise the theme's grey hover bar shows on our dark panel. -->
        <Style Selector="Button.kcapGhost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.kcapGhost /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.kcapGhost:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.kcapGhost:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.kcapGhost:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <!-- Ghost sizes. Declared after the ghost rules on purpose: a later style wins, so a
             size that also recolours has to come after the colour it replaces. -->
        <Style Selector="Button.kcapGhost.kcapIcon">
            <Setter Property="Padding" Value="7" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.kcapGhost.kcapQuiet">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.kcapGhost.kcapQuiet /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="Button.kcapGhost.kcapQuiet:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.kcapGhost.kcapQuiet:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.kcapGhost.kcapQuiet:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
        </Style>
        <!-- A destructive primary: filled like kcapPrimary so it reads as the action, never bound to
             Enter, so the default key cannot remove or stop anything. -->
        <Style Selector="Button.kcapDangerFill">
            <Setter Property="Background" Value="{StaticResource KcapDangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapDangerBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapOnPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.kcapDangerFill /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapDangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapDangerBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapOnPrimaryBrush}" />
        </Style>
        <!-- Hover dims the fill rather than swapping it, so the button still reads as destructive. -->
        <Style Selector="Button.kcapDangerFill:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.kcapDangerFill:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapDangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapDangerBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapOnPrimaryBrush}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.kcapDangerFill:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
        </Style>
        <!-- Destructive ghost (Stop): Fluent hover paints the presenter near-white, which hides
             the danger colour. Rest and hover both pin KcapDangerBrush. -->
        <Style Selector="Button.kcapDanger">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapDangerBrush}" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.kcapDanger /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapDangerBrush}" />
        </Style>
        <Style Selector="Button.kcapDanger:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.kcapDanger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapDangerDimBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapDangerBrush}" />
        </Style>
        <Style Selector="Button.kcapDanger:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapDangerBrush}" />
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <!-- Chat/Terminal/PR switch: a raised track with one selected cell, not underline tabs.
             Fluent hover still paints the presenter, so rest and active both pin it. -->
        <Style Selector="Border.kcapSegment">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.kcapSegmentItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Button.kcapSegmentItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.kcapSegmentItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.kcapSegmentItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.kcapSegmentItem.active /template/ ContentPresenter#PART_ContentPresenter,
                         Button.kcapSegmentItem.active:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.kcapSegmentItem.active:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSelectionBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <!-- A refresh glyph turning while its read is in flight: the click's only feedback when
             the result is unchanged. -->
        <Style Selector="views|AppIcon.kcapSpinning">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- A prompt card that takes dropped files. The resting border lives here rather than on
             the card so the drag-over ring can outrank it: a local value on the control beats
             every style, and a style closer to the control beats one declared here — which is why
             the resting brush cannot stay behind in the view either. -->
        <Style Selector="Border.attachTarget">
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
        </Style>
        <Style Selector="Border.goalNudgeRing">
            <Setter Property="BorderBrush" Value="{StaticResource KcapInfoBrush}" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.goalNudgeRing.on">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.attachTarget.dragOver">
            <Setter Property="BorderBrush" Value="{StaticResource KcapPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.toolKindChip">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ContextFlyout" Value="{x:Null}" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="12" />
            <Setter Property="MinHeight" Value="12" />
        </Style>
        <Style Selector="ScrollBar /template/ Border#VerticalRoot,
                         ScrollBar /template/ Border#HorizontalRoot,
                         ScrollBar:pointerover /template/ Border#VerticalRoot,
                         ScrollBar:pointerover /template/ Border#HorizontalRoot,
                         ScrollBar:expanded /template/ Border#VerticalRoot,
                         ScrollBar:expanded /template/ Border#HorizontalRoot">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="RadiusX" Value="6" />
            <Setter Property="RadiusY" Value="6" />
            <Setter Property="Margin" Value="1,2" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:expanded /template/ Rectangle#TrackRect">
            <Setter Property="Fill" Value="{StaticResource KcapInfoDimBrush}" />
            <Setter Property="Stroke" Value="{StaticResource KcapSelectionBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton,
                         ScrollBar /template/ RepeatButton#PART_LineDownButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton#PART_PageUpButton,
                         ScrollBar /template/ RepeatButton#PART_PageDownButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb,
                         ScrollBar:vertical /template/ Thumb,
                         ScrollBar:horizontal /template/ Thumb,
                         ScrollBar:vertical:expanded /template/ Thumb,
                         ScrollBar:horizontal:expanded /template/ Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Thumb">
                    <Border Name="ThumbPill"
                            Background="{StaticResource KcapInfoBrush}"
                            Opacity="0.45"
                            CornerRadius="99"
                            RenderTransformOrigin="50%,50%"
                            RenderTransform="scale(1, 1)">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
        </Style>
        <Style Selector="ScrollBar:horizontal /template/ Thumb">
            <Setter Property="Height" Value="12" />
            <Setter Property="MinHeight" Value="12" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb /template/ Border#ThumbPill">
            <Setter Property="Margin" Value="3,2" />
        </Style>
        <Style Selector="ScrollBar:horizontal /template/ Thumb /template/ Border#ThumbPill">
            <Setter Property="Margin" Value="2,3" />
        </Style>
        <Style Selector="ScrollBar:expanded /template/ Thumb /template/ Border#ThumbPill,
                         ScrollBar /template/ Thumb:pointerover /template/ Border#ThumbPill">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb:pressed /template/ Border#ThumbPill">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(0.72, 0.97)" />
        </Style>
        <Style Selector="ScrollBar:horizontal /template/ Thumb:pressed /template/ Border#ThumbPill">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(0.97, 0.72)" />
        </Style>
        <StyleInclude Source="avares://kcap-desktop/Views/SectionStyles.axaml" />
    </Application.Styles>
</Application>
