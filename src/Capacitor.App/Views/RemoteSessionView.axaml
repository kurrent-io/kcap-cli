<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             xmlns:services="clr-namespace:Capacitor.App.Services"
             x:Class="Capacitor.App.Views.RemoteSessionView"
             x:DataType="vm:RemoteSessionViewModel"
             Background="{StaticResource KcapCanvasBrush}">
    <!-- The session's process lives on another machine: the header, the switch over the server's
         streams, and the two actions that reach across. -->
    <Grid x:Name="SplitGrid" ColumnDefinitions="*,320">
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,16,16,16" Background="Transparent" PointerPressed="OnHeaderPointerPressed">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="RemoteTitle" Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"
                               Foreground="{StaticResource KcapTextBrush}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Title}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <views:AgentStatusMark x:Name="RemoteStatus" Classes="header"
                                               DataContext="{Binding Chat.AgentStatus}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock x:Name="RemoteSubtitle" Grid.Column="1" Text="{Binding RepoLabelText}" FontSize="13"
                                   Foreground="{StaticResource KcapMutedBrush}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border x:Name="SurfaceSwitch" Classes="kcapSegment" IsVisible="{Binding ShowsSurfaceSwitch}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="ChatTabButton" Content="Chat" Classes="kcapSegmentItem"
                                    Classes.active="{Binding IsChatActive}" Command="{Binding ShowChatCommand}" />
                            <Button x:Name="TerminalTabButton" Content="Terminal" Classes="kcapSegmentItem"
                                    Classes.active="{Binding IsTerminalActive}" Command="{Binding ShowTerminalCommand}"
                                    IsVisible="{Binding ShowsTerminalTab}" />
                            <Button x:Name="PullRequestTabButton" Content="Pull Request" Classes="kcapSegmentItem"
                                    Classes.active="{Binding IsPullRequestActive}" Command="{Binding ShowPullRequestCommand}"
                                    IsVisible="{Binding ShowsPullRequestTab}" />
                            <Button x:Name="ArtefactsTabButton" Content="Pages" Classes="kcapSegmentItem"
                                    Classes.active="{Binding IsArtefactsActive}" Command="{Binding ShowArtefactsCommand}"
                                    IsVisible="{Binding ShowsArtefactsTab}" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="OpenInWebButton" Command="{Binding OpenInWebCommand}"
                            Classes="kcapGhost kcapIcon" ToolTip.Tip="Open in web" AutomationProperties.Name="Open in web">
                        <views:AppIcon Kind="ExternalLink" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
                    </Button>
                    <Button x:Name="StopButton" Content="Stop" Command="{Binding StopCommand}" Classes="kcapDanger"
                            Padding="10,5" FontSize="13.5" IsVisible="{Binding ShowsStop}" />
                    <Button x:Name="ContextToggleButton" Classes="kcapGhost kcapIcon">
                        <views:AppIcon x:Name="ContextToggleIcon" Kind="PanelRightClose" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="AccessBanner" Grid.Row="1" Margin="20,10,20,0"
                Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="13,10"
                IsVisible="{Binding AccessNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock x:Name="AccessNoteText" Text="{Binding AccessNote}" TextWrapping="Wrap"
                       FontSize="13.5" Foreground="{StaticResource KcapMutedBrush}" />
        </Border>

        <Grid Grid.Row="2">
            <!-- The active-tab flag lives on this VM, which is not the pane's DataContext. -->
            <views:ChatTabView x:Name="ChatHost" DataContext="{Binding Chat}"
                               IsVisible="{Binding $parent[views:RemoteSessionView].((vm:RemoteSessionViewModel)DataContext).ShowsChatPane}" />
            <!-- Built only while a subagent is open, so the closed pane adds no second chat to the tree. -->
            <ContentControl x:Name="SubagentHost" Content="{Binding Subagent}" IsVisible="{Binding ShowsSubagentPane}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:SubagentPaneViewModel">
                        <views:SubagentPaneView IsVisible="{Binding $parent[views:RemoteSessionView].((vm:RemoteSessionViewModel)DataContext).ShowsSubagentPane}" />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <Grid x:Name="TerminalPane" RowDefinitions="*,Auto" IsVisible="{Binding ShowsTerminalPane}">
                <!-- A cross-platform monospace font keeps measured cells aligned with rendered text. -->
                <views:RemoteTerminalViewport x:Name="TerminalViewport" Grid.Row="0">
                    <views:RemoteTerminalControl x:Name="TerminalHost"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                               FontFamily="Menlo,Monaco,Consolas,Cascadia Mono,DejaVu Sans Mono,monospace"
                                               CaretBrush="{StaticResource KcapTextBrush}"
                                               SourceColumns="{Binding Terminal.SourceColumns}"
                                               SourceRows="{Binding Terminal.SourceRows}"
                                               Model="{Binding Terminal.Surface, Converter={x:Static views:TerminalSurfaceModelConverter.Instance}}" />
                </views:RemoteTerminalViewport>
                <Border Grid.Row="0" IsVisible="{Binding Terminal.ShowsBanner}"
                        Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0">
                    <TextBlock x:Name="TerminalPhaseNote" Text="{Binding Terminal.PhaseNote}" Foreground="{StaticResource KcapMutedBrush}" />
                </Border>
                <!-- Read-only: the keys the daemon accepts are the only input that crosses. -->
                <Border Grid.Row="1" BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="0,1,0,0" Padding="20,8">
                    <StackPanel Spacing="6">
                        <ItemsControl ItemsSource="{Binding Terminal.Keys}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:SpecialKeyChoice">
                                    <Button Classes="specialKey kcapChip" Content="{Binding Label}" Click="OnTerminalKeyClick" Padding="10,4" FontSize="12" CornerRadius="7"
                                            Command="{Binding $parent[views:RemoteSessionView].((vm:RemoteSessionViewModel)DataContext).Terminal.SendKeyCommand}"
                                            CommandParameter="{Binding Key}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Terminal.SizeNote}" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource KcapFaintBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
            <ContentControl x:Name="PullRequestPane" IsVisible="{Binding ShowsPullRequestPane}" />
            <ContentControl x:Name="ArtefactsPane" IsVisible="{Binding ShowsArtefactsPane}" />
        </Grid>
    </Grid>
    <!-- Collapsing hides this wrapper, so the pane's own visibility binding stays intact. -->
    <Panel x:Name="ContextColumn" Grid.Column="1">
        <views:WorkContextView x:Name="WorkContextHost" DataContext="{Binding WorkContext}"
                               IsVisible="{Binding $parent[views:RemoteSessionView].((vm:RemoteSessionViewModel)DataContext).ShowsPanes}" />
    </Panel>
    <!-- Last child so it hit-tests above the workspace column it overhangs. -->
    <GridSplitter x:Name="ContextSplitter" Grid.Column="1" HorizontalAlignment="Left" Width="6"
                  Margin="-3,0,0,0" Background="Transparent" ResizeDirection="Columns" />
    </Grid>
</UserControl>
