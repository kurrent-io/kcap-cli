<rxui:ReactiveWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:rxui="clr-namespace:ReactiveUI.Avalonia;assembly=ReactiveUI.Avalonia"
                     xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
                     x:Class="Capacitor.App.Views.UninstallWindow"
                     x:TypeArguments="vm:UninstallRunViewModel"
                     x:DataType="vm:UninstallRunViewModel"
                     Title="Uninstalling kcap"
                     Icon="avares://kcap-desktop/Assets/kcap-icon.png"
                     Width="520" Height="420"
                     CanResize="False" WindowStartupLocation="CenterScreen"
                     Background="{StaticResource KcapCanvasBrush}"
                     ExtendClientAreaToDecorationsHint="True">
    <Panel>
        <Border Height="32" VerticalAlignment="Top" Background="Transparent"
                PointerPressed="OnChromePointerPressed" />

        <StackPanel x:Name="HandoffContent" IsVisible="False" Margin="36,44,36,28" Spacing="18">
            <TextBlock Text="Uninstalling kcap…" FontSize="19" FontWeight="SemiBold" LineHeight="26"
                       LetterSpacing="-0.2" Foreground="{StaticResource KcapTextBrush}" />
            <TextBlock Text="Closing kcap before removing its background services and app."
                       TextWrapping="Wrap" Foreground="{StaticResource KcapMutedBrush}" />
            <ProgressBar IsIndeterminate="True" Height="4" />
        </StackPanel>

        <Grid x:Name="RunContent" Margin="36,44,36,28" RowDefinitions="Auto,*,Auto">
            <TextBlock Grid.Row="0" Text="{Binding Heading}"
                       FontSize="19" FontWeight="SemiBold" LineHeight="26" LetterSpacing="-0.2"
                       Foreground="{StaticResource KcapTextBrush}" />

            <Border Grid.Row="1" Margin="0,16,0,0" Padding="12,9" CornerRadius="8" BorderThickness="1"
                    Background="{StaticResource KcapSurfaceBrush}"
                    BorderBrush="{StaticResource KcapBorderBrush}">
                <ScrollViewer x:Name="LinesScroll">
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap"
                                                     FontSize="12" LineHeight="18"
                                                     FontFamily="{StaticResource OnboardingMonoFont}"
                                                     Foreground="{StaticResource KcapMutedBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,22,0,0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Retry" Classes="kcapChip" Command="{Binding RetryCommand}"
                        IsVisible="{Binding CanRetry}" />
                <Button Content="Close" Classes="kcapChip" Command="{Binding CloseCommand}" />
            </StackPanel>
        </Grid>
    </Panel>
</rxui:ReactiveWindow>
