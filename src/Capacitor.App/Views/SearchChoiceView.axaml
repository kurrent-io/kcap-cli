<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             x:Class="Capacitor.App.Views.SearchChoiceView"
             x:DataType="vm:SearchChoiceViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.detail">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="10">
        <TextBlock Classes="detail" Text="{x:Static vm:SearchChoiceViewModel.Explainer}" />
        <RadioButton x:Name="SearchKeywordOption" Classes="onboardingOption"
                     IsChecked="{Binding UseKeyword, Mode=TwoWay}">
            <StackPanel Spacing="3">
                <TextBlock Text="Search by keyword" />
                <TextBlock Classes="detail" Text="{x:Static vm:SearchChoiceViewModel.KeywordDetail}" />
            </StackPanel>
        </RadioButton>
        <StackPanel Spacing="2">
            <RadioButton x:Name="SearchMeaningOption" Classes="onboardingOption"
                         IsChecked="{Binding UseMeaning, Mode=TwoWay}" IsEnabled="{Binding MeaningEnabled}">
                <StackPanel Spacing="3">
                    <TextBlock Text="Search by meaning" />
                    <TextBlock Classes="detail" Text="{x:Static vm:SearchChoiceViewModel.MeaningDetail}" />
                </StackPanel>
            </RadioButton>
            <!-- Outside the option, so Check again stays clickable while the option is disabled; the left
                 margin lines it up with the option's text (border, padding, ring and gap). -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="35,0,11,0"
                  IsVisible="{Binding OllamaStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock x:Name="OllamaStatusText" Classes="detail" VerticalAlignment="Center" Text="{Binding OllamaStatus}" />
                <Button Grid.Column="1" x:Name="CheckOllamaButton" Classes="kcapChip" Content="{Binding CheckLabel}"
                        VerticalAlignment="Center" Command="{Binding CheckOllamaCommand}" IsVisible="{Binding OllamaMissing}" />
            </Grid>
        </StackPanel>
        <StackPanel Spacing="8" Margin="28,0,0,0" IsVisible="{Binding ModelChoiceVisible}">
            <RadioButton x:Name="SearchDefaultOption" Classes="onboardingOption"
                         IsChecked="{Binding UseDefault, Mode=TwoWay}">
                <StackPanel Spacing="3">
                    <TextBlock Text="{x:Static vm:SearchChoiceViewModel.DefaultLabel}" TextWrapping="Wrap" />
                    <TextBlock Classes="detail" Text="{x:Static vm:SearchChoiceViewModel.DefaultDetail}" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="SearchOtherOption" Classes="onboardingOption"
                         IsChecked="{Binding UseOther, Mode=TwoWay}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Another Ollama model" />
                    <TextBox x:Name="SearchOtherModel" Classes="kcapField"
                             PlaceholderText="Model name, e.g. nomic-embed-text" Text="{Binding OtherModel, Mode=TwoWay}"
                             IsVisible="{Binding UseOther}" AutomationProperties.Name="Ollama embedding model" />
                    <TextBlock x:Name="SearchOtherModelError" Classes="detail" Text="{Binding OtherModelError}"
                               Foreground="{StaticResource KcapDangerBrush}"
                               IsVisible="{Binding OtherModelError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </RadioButton>
            <TextBlock Classes="detail" Text="{x:Static vm:SearchChoiceViewModel.ModelChangeDetail}" IsVisible="{Binding Reconfiguring}" />
        </StackPanel>
    </StackPanel>
</UserControl>
