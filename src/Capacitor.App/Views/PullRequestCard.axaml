<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             x:Class="Capacitor.App.Views.PullRequestCard"
             x:DataType="vm:PullRequestContextViewModel">
    <StackPanel Spacing="9">
            <ComboBox x:Name="PullRequestSelector" Classes="kcapField"
                      ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                      IsVisible="{Binding HasMultipleChoices}" HorizontalAlignment="Stretch" FontSize="13"
                      AutomationProperties.Name="Linked pull request">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PullRequestChoice">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasChoice}">
                <StackPanel Spacing="4" VerticalAlignment="Top">
                    <Panel IsVisible="{Binding CanDisplay}">
                        <views:PullRequestStatusLabel DataContext="{Binding LifecycleStatus}" />
                    </Panel>
                    <TextBlock Text="{Binding RepositoryLabel}" Classes="prMuted" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding RepositoryLabel}" />
                </StackPanel>
                <Button x:Name="OpenGitHubButton" Grid.Column="1" Command="{Binding OpenGitHubCommand}" IsEnabled="{Binding CanOpenSource}"
                        IsVisible="{Binding ShowsOpenSource}" Classes="prButton" VerticalAlignment="Center"
                        AutomationProperties.Name="Open pull request in browser">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding ProviderLabel}" VerticalAlignment="Center" />
                        <Path Classes="prExternal prAfterLabel" />
                    </StackPanel>
                </Button>
            </Grid>
            <Button x:Name="PullRequestTitleButton" Classes="copyValue" Command="{Binding OpenReaderCommand}"
                    IsEnabled="{Binding CanOpenReader}" HorizontalAlignment="Stretch"
                    IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    AutomationProperties.Name="Open pull request overview">
                <TextBlock Text="{Binding Title}" FontSize="13" LineHeight="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" Foreground="{StaticResource KcapTextBrush}" />
            </Button>
            <StackPanel IsVisible="{Binding CanDisplay}">
                <Button x:Name="SidebarChecksButton" Classes="prStatusRow" Command="{Binding ShowSectionCommand}" CommandParameter="checks"
                        IsEnabled="{Binding CanReveal}" ToolTip.Tip="{Binding ChecksStatus.Tip}"
                        AutomationProperties.Name="{Binding ChecksStatus.Text, StringFormat='Open checks: {0}'}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <views:PullRequestStatusLabel DataContext="{Binding ChecksStatus}" />
                        <Path Grid.Column="1" Classes="prChevron" />
                    </Grid>
                </Button>
                <Button x:Name="SidebarReviewsButton" Classes="prStatusRow" Command="{Binding ShowSectionCommand}" CommandParameter="reviewers"
                        IsEnabled="{Binding CanReveal}" ToolTip.Tip="{Binding ReviewStatus.Tip}"
                        AutomationProperties.Name="{Binding ReviewStatus.Text, StringFormat='Open reviews: {0}'}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <views:PullRequestStatusLabel DataContext="{Binding ReviewStatus}" />
                        <Path Grid.Column="1" Classes="prChevron" />
                    </Grid>
                </Button>
            </StackPanel>
            <TextBlock x:Name="OverviewFreshness" Text="{Binding OverviewFreshnessLabel}" IsVisible="{Binding HasStaleOverview}" Classes="prNote" />
            <TextBlock Text="{Binding Notice}" IsVisible="{Binding HasNotice}" Classes="prNote" />
            <TextBlock Text="{Binding ReaderNote}" IsVisible="{Binding HasReaderNote}" Classes="prNote" />
            <WrapPanel IsVisible="{Binding HasReaderNote}">
                <Button Content="{Binding InstallToolLabel}" Command="{Binding InstallToolCommand}" IsVisible="{Binding ShowsInstallTool}" Classes="prButton prPrimary" Margin="0,0,8,0" />
                <Button Content="Recheck" Command="{Binding RefreshCommand}" Classes="prButton" />
            </WrapPanel>
            <Button Content="Sign in" Command="{Binding SignInCommand}" IsVisible="{Binding ShowsSignIn}" Classes="prButton prPrimary" HorizontalAlignment="Left" />
            <Button Content="Link GitHub" Command="{Binding LinkGitHubCommand}" IsVisible="{Binding ShowsLinkGitHub}" Classes="prButton prPrimary" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
