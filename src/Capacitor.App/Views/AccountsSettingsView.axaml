<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             xmlns:accounts="clr-namespace:Capacitor.Cli.Core.Accounts;assembly=Capacitor.Cli.Core"
             x:Class="Capacitor.App.Views.AccountsSettingsView"
             x:DataType="vm:AccountsSettingsViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.summaryValue">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="TextBlock.summaryValue.attention">
            <Setter Property="Foreground" Value="{StaticResource KcapWarningBrush}" />
        </Style>
        <Style Selector="TextBlock.accountState.attention">
            <Setter Property="Foreground" Value="{StaticResource KcapWarningBrush}" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
        <StackPanel Spacing="16">
            <StackPanel Spacing="10">
                <TextBlock x:Name="AccountsTitleText" Classes="kcapTitle" Text="Accounts" LineHeight="22" />
                <TextBlock Classes="kcapSubtitle" TextWrapping="Wrap"
                           Text="Claude and Codex config directories on this machine. Each records its sessions and can be picked when a session starts." />
            </StackPanel>

            <TextBlock x:Name="AccountsNoticeText" Classes="kcapHint" Text="{Binding ReadOnlyNotice}" TextWrapping="Wrap"
                       IsVisible="{Binding ReadOnlyNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <UniformGrid x:Name="AccountSummaryCards" Columns="3">
                <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,6,0">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="kcapLabel" Text="Ready for a long run" />
                        <TextBlock Classes="summaryValue" Classes.attention="{Binding ReadyCard.Attention}" Text="{Binding ReadyCard.Value}" />
                        <TextBlock Classes="kcapHint" Text="{Binding ReadyCard.Detail}" TextWrapping="Wrap"
                                   IsVisible="{Binding ReadyCard.Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="6,0">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="kcapLabel" Text="Next reset" />
                        <TextBlock Classes="summaryValue" Classes.attention="{Binding NextResetCard.Attention}" Text="{Binding NextResetCard.Value}" />
                        <TextBlock Classes="kcapHint" Text="{Binding NextResetCard.Detail}" TextWrapping="Wrap"
                                   IsVisible="{Binding NextResetCard.Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="6,0,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="kcapLabel" Text="Need a fix" />
                        <TextBlock Classes="summaryValue" Classes.attention="{Binding NeedsFixCard.Attention}" Text="{Binding NeedsFixCard.Value}" />
                        <TextBlock Classes="kcapHint" Text="{Binding NeedsFixCard.Detail}" TextWrapping="Wrap"
                                   IsVisible="{Binding NeedsFixCard.Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <ItemsControl x:Name="AccountGroups" ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountVendorGroup">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="kcapLabel" Text="{Binding VendorLabel}" />
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccountSettingsRow">
                                        <Border Classes="profileRow accountRow" Background="{StaticResource KcapSurfaceBrush}"
                                                BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <StackPanel.IsVisible>
                                                            <MultiBinding Converter="{x:Static views:SameValueConverter.Different}">
                                                                <Binding />
                                                                <Binding Path="$parent[views:AccountsSettingsView].((vm:AccountsSettingsViewModel)DataContext).Renaming" />
                                                            </MultiBinding>
                                                        </StackPanel.IsVisible>
                                                        <TextBlock Classes="kcapLabel accountLabel" Text="{Binding Label}" VerticalAlignment="Center" />
                                                        <Border Classes="accountDefault" IsVisible="{Binding IsDefault}"
                                                                Background="{StaticResource KcapSurfaceRaisedBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                                                                BorderThickness="1" CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                                                            <TextBlock Text="Default" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource KcapMutedBrush}" />
                                                        </Border>
                                                        <Border Classes="accountPlan" IsVisible="{Binding Plan, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                Background="{StaticResource KcapSurfaceRaisedBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                                                                BorderThickness="1" CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Plan}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource KcapMutedBrush}" />
                                                        </Border>
                                                        <Border Classes="accountBlocked" IsVisible="{Binding Usage.View.BlockedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                Background="{StaticResource KcapDangerDimBrush}" CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Usage.View.BlockedText}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource KcapDangerBrush}" />
                                                        </Border>
                                                        <TextBlock Classes="kcapHint" Text="{Binding Email}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{Binding Email, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <StackPanel.IsVisible>
                                                            <MultiBinding Converter="{x:Static views:SameValueConverter.Same}">
                                                                <Binding />
                                                                <Binding Path="$parent[views:AccountsSettingsView].((vm:AccountsSettingsViewModel)DataContext).Renaming" />
                                                            </MultiBinding>
                                                        </StackPanel.IsVisible>
                                                        <TextBox Classes="kcapField" Width="180" AutomationProperties.Name="Account label"
                                                                 Text="{Binding $parent[views:AccountsSettingsView].((vm:AccountsSettingsViewModel)DataContext).RenameDraft, Mode=TwoWay}" />
                                                        <Button Classes="kcapChip" Content="Save" VerticalAlignment="Center"
                                                                Command="{Binding $parent[views:AccountsSettingsView].((vm:AccountsSettingsViewModel)DataContext).CommitRenameCommand}" />
                                                        <Button Classes="kcapChip" Content="Cancel" VerticalAlignment="Center"
                                                                Command="{Binding $parent[views:AccountsSettingsView].((vm:AccountsSettingsViewModel)DataContext).CancelRenameCommand}" />
                                                    </StackPanel>
                                                    <TextBlock Classes="kcapHint" Text="{Binding Directory}" TextWrapping="Wrap" />
                                                    <TextBlock Classes="kcapHint accountState" Classes.attention="{Binding StateIsAttention}"
                                                               Text="{Binding StateLabel}" ToolTip.Tip="{Binding StateHint}" />
                                                    <ContentControl Content="{Binding Usage.View}">
                                                        <ContentControl.ContentTemplate>
                                                            <DataTemplate x:DataType="vm:AccountUsageView">
                                                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                                                    <ItemsControl ItemsSource="{Binding Bars}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Spacing="6" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:UsageBar">
                                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                    <TextBlock Classes="kcapHint" Text="{Binding Label}" Width="44" VerticalAlignment="Center" />
                                                                                    <Border Width="160" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                                                                            Background="{StaticResource KcapBorderBrush}">
                                                                                        <Border HorizontalAlignment="Left" CornerRadius="3"
                                                                                                Width="{Binding ., Converter={x:Static views:UsageBarFillConverter.Instance}, ConverterParameter=160}"
                                                                                                Background="{Binding Tone, Converter={x:Static views:UsageToneBrushConverter.Instance}}" />
                                                                                    </Border>
                                                                                    <TextBlock Text="{Binding PercentText}" Width="44" VerticalAlignment="Center"
                                                                                               Foreground="{Binding Tone, Converter={x:Static views:UsageToneBrushConverter.Instance}, ConverterParameter=Text}" />
                                                                                    <TextBlock Classes="kcapHint" Text="{Binding ResetText}" VerticalAlignment="Center"
                                                                                               IsVisible="{Binding ResetText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <TextBlock Classes="kcapHint" Text="{Binding LineText}" TextWrapping="Wrap"
                                                                               IsVisible="{Binding LineText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                    <TextBlock Classes="kcapHint" Text="{Binding PerModelText}" TextWrapping="Wrap"
                                                                               IsVisible="{Binding PerModelText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                    <TextBlock Classes="kcapHint" Text="{Binding AgeText}" TextWrapping="Wrap"
                                                                               IsVisible="{Binding AgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ContentControl.ContentTemplate>
                                                    </ContentControl>
                                                    <TextBlock Classes="kcapHint accountError" Text="{Binding ErrorText}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource KcapWarningBrush}"
                                                               IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                                <Panel Grid.Column="1" VerticalAlignment="Top">
                                                    <Button Classes="kcapGhost kcapIcon accountMenu" IsVisible="{Binding !IsUnregisteredDefault}"
                                                            IsEnabled="{Binding !$parent[views:AccountsSettingsView].((vm:AccountsSettingsViewModel)DataContext).IsBusy}"
                                                            AutomationProperties.Name="{Binding Label, StringFormat='Actions for {0}'}"
                                                            ToolTip.Tip="Refresh, rename, re-wire or remove">
                                                        <views:AppIcon Kind="Ellipsis" Size="16" />
                                                        <Button.Flyout>
                                                            <Flyout Placement="BottomEdgeAlignedRight" VerticalOffset="6"
                                                                    FlyoutPresenterClasses="kcapPanel" Opened="OnMenuOpened">
                                                                <StackPanel Spacing="2" Margin="6" MinWidth="160">
                                                                    <Button Classes="kcapGhost" Content="Refresh" Click="OnMenuItemClick" CommandParameter="{Binding}"
                                                                            Command="{Binding $parent[views:AccountsSettingsView].((vm:AccountsSettingsViewModel)DataContext).RefreshCommand}"
                                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                            Padding="10,8" FontSize="13.5" />
                                                                    <Button Classes="kcapGhost" Content="Rename" Click="OnMenuItemClick" CommandParameter="{Binding}"
                                                                            Command="{Binding $parent[views:AccountsSettingsView].((vm:AccountsSettingsViewModel)DataContext).BeginRenameCommand}"
                                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                            Padding="10,8" FontSize="13.5" />
                                                                    <Button Classes="kcapGhost" Content="Re-wire" Click="OnMenuItemClick" CommandParameter="{Binding}"
                                                                            Command="{Binding $parent[views:AccountsSettingsView].((vm:AccountsSettingsViewModel)DataContext).RewireCommand}"
                                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                            Padding="10,8" FontSize="13.5" />
                                                                    <Button Classes="kcapGhost" Content="Remove" Click="OnMenuItemClick" CommandParameter="{Binding}"
                                                                            Command="{Binding $parent[views:AccountsSettingsView].((vm:AccountsSettingsViewModel)DataContext).RemoveCommand}"
                                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                            Padding="10,8" FontSize="13.5" />
                                                                </StackPanel>
                                                            </Flyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                    <Button Classes="kcapChip accountAdd" Content="Add" IsVisible="{Binding IsUnregisteredDefault}"
                                                            Command="{Binding $parent[views:AccountsSettingsView].((vm:AccountsSettingsViewModel)DataContext).AddDefaultCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="AddAccountButton" Classes="kcapChip" Content="Add account" HorizontalAlignment="Left"
                    IsVisible="{Binding CanManage}" IsEnabled="{Binding !IsBusy}">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft" VerticalOffset="6" FlyoutPresenterClasses="kcapPanel"
                            Opening="OnAddMenuOpening" Opened="OnMenuOpened">
                        <StackPanel Spacing="2" Margin="6" MinWidth="280">
                            <ItemsControl x:Name="AddAccountCandidates" ItemsSource="{Binding Candidates}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="accounts:AccountCandidate">
                                        <Button Classes="kcapGhost" Click="OnMenuItemClick"
                                                Command="{Binding $parent[views:AccountsSettingsView].((vm:AccountsSettingsViewModel)DataContext).AddCandidateCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <ContentControl VerticalAlignment="Center"
                                                                Content="{Binding Vendor, Converter={x:Static views:VendorGlyphConverter.Instance}, ConverterParameter=14}" />
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Directory}" FontSize="13.5" />
                                                    <TextBlock Text="{Binding Reason}" FontSize="11.5" Foreground="{StaticResource KcapMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Margin="8,4" Background="{StaticResource KcapBorderBrush}"
                                    IsVisible="{Binding !!Candidates.Count}" />
                            <Button Classes="kcapGhost" Content="Choose a Claude directory…" Click="OnMenuItemClick"
                                    Command="{Binding AddFromPickerCommand}" CommandParameter="claude"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" FontSize="13.5" />
                            <Button Classes="kcapGhost" Content="Choose a Codex directory…" Click="OnMenuItemClick"
                                    Command="{Binding AddFromPickerCommand}" CommandParameter="codex"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" FontSize="13.5" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <TextBlock x:Name="AccountsMessageText" Classes="kcapHint" Text="{Binding Message}" TextWrapping="Wrap"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
