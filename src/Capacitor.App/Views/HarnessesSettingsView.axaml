<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             x:Class="Capacitor.App.Views.HarnessesSettingsView" x:DataType="vm:HarnessesSettingsViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Classes="settingsPage">
            <StackPanel Spacing="10">
                <TextBlock Classes="kcapTitle" Text="Harnesses" />
                <TextBlock Classes="kcapSubtitle" Text="Choose which coding tools connect to kcap on this computer." TextWrapping="Wrap" />
                <Border Classes="settingsContextChip">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Profile" FontSize="11" FontWeight="Medium" LetterSpacing="0.2"
                                   Foreground="{StaticResource KcapMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ProfileName}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource KcapTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Classes="kcapHint" TextWrapping="Wrap"
                           Text="Selecting a harness installs kcap's recording hooks, plugins and tools. Unselecting it removes that setup. Your coding tool and existing sessions are kept. Restart the harness after a change." />
                <Button x:Name="RescanHarnessesButton" Classes="kcapChip" Content="Rescan harnesses"
                        HorizontalAlignment="Left" Command="{Binding RescanCommand}" />
            </StackPanel>

            <ItemsControl x:Name="HarnessSettingsRows" ItemsSource="{Binding Rows}" IsEnabled="{Binding !Busy}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HarnessSettingsRow">
                        <Border BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14">
                            <StackPanel Spacing="2">
                                <CheckBox Classes="settingsHarnessCheck" IsChecked="{Binding IsConfigured, Mode=OneWay}"
                                          AutomationProperties.Name="{Binding Label, StringFormat='Connect {0} to kcap'}"
                                          AutomationProperties.HelpText="{Binding ConnectionLabel}" ToolTip.Tip="{Binding Signal}"
                                          Command="{Binding $parent[ItemsControl].((vm:HarnessesSettingsViewModel)DataContext).ToggleConnectionCommand}"
                                          CommandParameter="{Binding}">
                                    <TextBlock Classes="kcapLabel" Text="{Binding Label}" TextWrapping="Wrap" />
                                </CheckBox>
                                <StackPanel Margin="32,0,0,0" Spacing="8">
                                    <TextBlock Classes="kcapHint" Text="{Binding ConnectionLabel}" TextWrapping="Wrap" />
                                    <TextBlock Classes="kcapHint" Text="{Binding ConsentNote}" TextWrapping="Wrap"
                                               IsVisible="{Binding ConsentNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <Button Classes="kcapChip" Content="Repair connection" HorizontalAlignment="Left"
                                            AutomationProperties.Name="{Binding Label, StringFormat='Repair {0} connection'}"
                                            IsVisible="{Binding IsConfigured}"
                                            Command="{Binding $parent[ItemsControl].((vm:HarnessesSettingsViewModel)DataContext).ConnectCommand}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Classes="kcapHint" Text="{Binding Message}" TextWrapping="Wrap"
                                               Foreground="{StaticResource KcapTextBrush}"
                                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="kcapHint" Text="{Binding Message}" TextWrapping="Wrap"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
