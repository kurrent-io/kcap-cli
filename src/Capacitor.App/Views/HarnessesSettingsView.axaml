<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             x:Class="Capacitor.App.Views.HarnessesSettingsView" x:DataType="vm:HarnessesSettingsViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Classes="settingsPage">
            <StackPanel Spacing="10">
                <TextBlock Classes="kcapTitle" Text="Harnesses" />
                <TextBlock Classes="kcapSubtitle" Text="Connect the coding tools on this machine to kcap." TextWrapping="Wrap" />
                <Border Classes="settingsContextChip">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Profile" FontSize="11" FontWeight="Medium" LetterSpacing="0.2"
                                   Foreground="{StaticResource KcapMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ProfileName}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource KcapTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Classes="settingsEyebrow" Text="Found on this machine" VerticalAlignment="Center" />
                    <Button x:Name="RescanHarnessesButton" Grid.Column="1" Classes="kcapChip" Content="Rescan"
                            Command="{Binding RescanCommand}" />
                </Grid>
                <TextBlock Classes="kcapHint" TextWrapping="Wrap"
                           Text="Connect installs recording and kcap tools into a harness; restart the harness afterwards. Status reflects local setup only, not the harness's own sign-in." />
            </StackPanel>

            <ItemsControl x:Name="HarnessSettingsRows" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HarnessSettingsRow">
                        <Border BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel Spacing="5">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Classes="kcapLabel" Text="{Binding Label}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                     Fill="{StaticResource KcapSuccessBrush}" IsVisible="{Binding IsConfigured}" />
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                     Fill="{StaticResource KcapFaintBrush}" IsVisible="{Binding !IsConfigured}" />
                                            <TextBlock Classes="kcapHint" Text="{Binding ConnectionLabel}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Classes="kcapHint" Text="{Binding Signal}" TextWrapping="Wrap"
                                               Foreground="{StaticResource KcapFaintBrush}" />
                                    <TextBlock Classes="kcapHint" Text="{Binding ConsentNote}" TextWrapping="Wrap"
                                               IsVisible="{Binding ConsentNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Classes="kcapHint" Text="{Binding Message}" TextWrapping="Wrap"
                                               Foreground="{StaticResource KcapTextBrush}"
                                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="kcapChip" Content="{Binding ActionLabel}" VerticalAlignment="Top"
                                        AutomationProperties.Name="{Binding Label, StringFormat='Connect {0}'}"
                                        Command="{Binding $parent[ItemsControl].((vm:HarnessesSettingsViewModel)DataContext).ConnectCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="kcapHint" Text="{Binding Message}" TextWrapping="Wrap"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
