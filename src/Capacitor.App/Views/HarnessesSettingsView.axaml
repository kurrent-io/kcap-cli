<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             x:Class="Capacitor.App.Views.HarnessesSettingsView" x:DataType="vm:HarnessesSettingsViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <views:SettingsPage Classes="settingsPage">
            <StackPanel Classes="settingsHeader">
                <TextBlock Classes="kcapTitle" Text="Harnesses" />
                <TextBlock Classes="kcapSubtitle" Text="Choose which coding tools connect to kcap on this computer." TextWrapping="Wrap" />
                <Border Classes="settingsContextChip" ToolTip.Tip="These settings apply only to this profile">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <views:AppIcon Kind="UserRound" Size="12" />
                        <TextBlock Text="Profile" />
                        <TextBlock Classes="scopeName" Text="{Binding ProfileName}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Classes="settingsGroup">
                <StackPanel Classes="settingsGroupHeader">
                    <TextBlock Classes="settingsGroupTitle" Text="Coding tools" />
                    <TextBlock Classes="kcapHint" TextWrapping="Wrap"
                               Text="Connecting installs kcap's recording hooks, plugins and tools; disconnecting removes them. Restart a tool after a change." />
                </StackPanel>

                <Border Classes="settingsCard" IsVisible="{Binding !!Rows.Count}">
                    <ItemsControl x:Name="HarnessSettingsRows" ItemsSource="{Binding Rows}" IsEnabled="{Binding !Busy}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HarnessSettingsRow">
                                <Border Classes="settingsListRow">
                                    <Grid Classes="settingsRow" ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                        <CheckBox Classes="settingsHarnessCheck" IsChecked="{Binding IsConfigured, Mode=OneWay}"
                                                  AutomationProperties.Name="{Binding Label, StringFormat='Connect {0} to kcap'}"
                                                  AutomationProperties.HelpText="{Binding ConnectionLabel}" ToolTip.Tip="{Binding Signal}"
                                                  Command="{Binding $parent[ItemsControl].((vm:HarnessesSettingsViewModel)DataContext).ToggleConnectionCommand}"
                                                  CommandParameter="{Binding}" />
                                        <Border Grid.Column="1" Classes="settingsGlyphTile">
                                            <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Content="{Binding Id, Converter={x:Static views:VendorGlyphConverter.Instance}, ConverterParameter=16}" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Classes="settingsRowText">
                                            <TextBlock Classes="kcapLabel" Text="{Binding Label}" TextWrapping="Wrap" />
                                            <TextBlock Classes="kcapHint" Text="{Binding ConnectionLabel}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Classes="kcapGhost settingsCompact" Content="Repair"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding Label, StringFormat='Repair {0} connection'}"
                                                ToolTip.Tip="Reinstall kcap's hooks for this tool"
                                                IsVisible="{Binding IsConfigured}"
                                                Command="{Binding $parent[ItemsControl].((vm:HarnessesSettingsViewModel)DataContext).ConnectCommand}"
                                                CommandParameter="{Binding}" />
                                        <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Spacing="8">
                                            <StackPanel.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                    <Binding Path="ConsentNote" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                                    <Binding Path="Message" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                                </MultiBinding>
                                            </StackPanel.IsVisible>
                                            <TextBlock Classes="settingsFootnote" Text="{Binding ConsentNote}" Margin="0,8,0,0"
                                                       IsVisible="{Binding ConsentNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Classes="kcapHint" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Foreground="{StaticResource KcapTextBrush}">
                                                <TextBlock.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="Message" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                                        <Binding Path="ErrorTitle" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                                    </MultiBinding>
                                                </TextBlock.IsVisible>
                                            </TextBlock>
                                            <Border Classes="settingsError" Margin="0,8,0,0"
                                                    IsVisible="{Binding ErrorTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <views:AppIcon Kind="CircleAlert" Size="14" Foreground="{StaticResource KcapDangerBrush}"
                                                                   VerticalAlignment="Top" Margin="0,2,0,0" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Classes="settingsErrorTitle" Text="{Binding ErrorTitle}" />
                                                        <SelectableTextBlock Classes="settingsErrorDetail" Text="{Binding Message}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Classes="settingsFootnote" IsVisible="{Binding !Rows.Count}"
                           Text="No coding tools found on this computer. Install one, then rescan." />
                <TextBlock Classes="settingsFootnote" Text="Your coding tools and their existing sessions are kept either way." />
                <Button x:Name="RescanHarnessesButton" Classes="kcapChip settingsCompact" HorizontalAlignment="Left"
                        Command="{Binding RescanCommand}" AutomationProperties.Name="Rescan harnesses"
                        ToolTip.Tip="Look again for coding tools installed on this computer">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <views:AppIcon Kind="RefreshCw" Size="14" />
                        <TextBlock Text="Rescan coding tools" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Classes="kcapHint" Text="{Binding Message}" TextWrapping="Wrap"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </views:SettingsPage>
    </ScrollViewer>
</UserControl>
