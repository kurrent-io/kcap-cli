<rxui:ReactiveWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:views="clr-namespace:Capacitor.App.Views"
                     xmlns:rxui="clr-namespace:ReactiveUI.Avalonia;assembly=ReactiveUI.Avalonia"
                     xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
                     x:Class="Capacitor.App.Views.LifecyclePromptWindow"
                     x:TypeArguments="vm:LifecyclePromptViewModel"
                     x:DataType="vm:LifecyclePromptViewModel"
                     Title="{Binding Title}"
                     Icon="avares://kcap-desktop/Assets/kcap-icon.png"
                     Width="480" SizeToContent="Height" MaxHeight="560"
                     CanResize="False" Topmost="True" WindowStartupLocation="CenterOwner"
                     Background="{StaticResource KcapCanvasBrush}"
                     ExtendClientAreaToDecorationsHint="True">
    <!-- The disclosure TextBlocks carry an explicit Width: SizeToContent="Height" needs a bound for
         the wrap to settle against, and the headless platform never completes measure without it. -->
    <Panel>
        <Border Height="32" VerticalAlignment="Top" Background="Transparent"
                PointerPressed="OnChromePointerPressed" />

        <Grid Margin="36,44,36,28" RowDefinitions="*,Auto">
            <ScrollViewer Grid.Row="0">
                <StackPanel>
                    <views:UpdateIcon HorizontalAlignment="Left" IsVisible="{Binding IsUpdate}" />
                    <Panel Width="64" Height="64" HorizontalAlignment="Left" IsVisible="{Binding !IsUpdate}">
                        <Image Source="avares://kcap-desktop/Assets/kcap-icon.png"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <Border CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource KcapBorderBrush}" />
                    </Panel>

                    <TextBlock Margin="0,20,0,0" Text="{Binding Title}"
                               HorizontalAlignment="Left" TextAlignment="Left"
                               FontSize="19" FontWeight="SemiBold" LineHeight="26" LetterSpacing="-0.2"
                               Foreground="{StaticResource KcapTextBrush}" />

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Left" IsVisible="{Binding ShowVersionChange}">
                        <Border Padding="10,3" CornerRadius="999" BorderThickness="1"
                                IsVisible="{Binding ShowInstalledVersion}"
                                Background="{StaticResource KcapSurfaceBrush}"
                                BorderBrush="{StaticResource KcapBorderBrush}">
                            <TextBlock Text="{Binding InstalledVersion}" FontSize="12" FontFamily="{StaticResource OnboardingMonoFont}"
                                       Foreground="{StaticResource KcapMutedBrush}" />
                        </Border>
                        <views:AppIcon Kind="ArrowRight" Size="12" VerticalAlignment="Center" IsVisible="{Binding ShowInstalledVersion}"
                                       Foreground="{StaticResource KcapMutedBrush}" />
                        <Border Padding="10,3" CornerRadius="999" BorderThickness="1"
                                Background="{StaticResource KcapSurfaceBrush}"
                                BorderBrush="{StaticResource KcapBorderBrush}">
                            <TextBlock Text="{Binding UpdateVersion}" FontSize="12" FontFamily="{StaticResource OnboardingMonoFont}"
                                       Foreground="{StaticResource KcapTextBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="10" IsVisible="{Binding ShowCurrentVersion}">
                        <TextBlock Text="Installed version" VerticalAlignment="Center" FontSize="12.5"
                                   Foreground="{StaticResource KcapMutedBrush}" />
                        <Border Padding="10,3" CornerRadius="999" BorderThickness="1"
                                Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}">
                            <TextBlock Text="{Binding InstalledVersion}" FontSize="12" FontFamily="{StaticResource OnboardingMonoFont}"
                                       Foreground="{StaticResource KcapTextBrush}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Margin="0,14,0,0" Width="400" Text="{Binding Disclosure}"
                               HorizontalAlignment="Left" TextAlignment="Left" TextWrapping="Wrap"
                               FontSize="13.5" LineHeight="21"
                               Foreground="{StaticResource KcapMutedBrush}" />

                    <Border Margin="0,16,0,0" Padding="12,9" CornerRadius="8" BorderThickness="1"
                            Background="{StaticResource KcapWarningDimBrush}"
                            BorderBrush="{StaticResource KcapWarningBrush}"
                            IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Width="374"
                                   FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource KcapWarningBrush}" />
                    </Border>

                    <Border Margin="0,16,0,0" Padding="12,9" CornerRadius="8" BorderThickness="1"
                            Background="{StaticResource KcapWarningDimBrush}"
                            BorderBrush="{StaticResource KcapWarningBrush}"
                            IsVisible="{Binding DegradedPathText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding DegradedPathText}" TextWrapping="Wrap" Width="374"
                                   FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource KcapWarningBrush}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Margin="0,22,0,0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Not now" Classes="kcapChip" Command="{Binding DeclineCommand}" IsCancel="True"
                        IsVisible="{Binding ShowDeclineButton}" />
                <Button x:Name="AcceptButton" Content="{Binding AcceptButtonText}" Command="{Binding AcceptCommand}"
                        Classes.kcapPrimary="{Binding !AcceptIsDestructive}" Classes.kcapDangerFill="{Binding AcceptIsDestructive}"
                        IsDefault="{Binding !AcceptIsDestructive}" />
            </StackPanel>
        </Grid>
    </Panel>
</rxui:ReactiveWindow>
