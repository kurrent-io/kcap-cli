<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             xmlns:svc="clr-namespace:Capacitor.App.Services"
             xmlns:cmd="clr-namespace:Capacitor.Cli.Core.Commands;assembly=Capacitor.Cli.Core"
             x:Class="Capacitor.App.Views.SessionRailView"
             x:DataType="vm:MainWindowViewModel">
    <!-- DataContext is INHERITED from the window (never assigned here), so Rail is null on any
         window built without one — every Rail.* binding below carries a fallback for that. -->
    <UserControl.Styles>
        <!-- A row's resting Background and BorderThickness MUST come from this class style, never a
             local attribute on the Button: a local value outranks a style trigger, which would leave
             the highlight styles below permanently inert (and suppress the theme's hover/pressed
             feedback). Avalonia has no CSS specificity, so the highlights are declared AFTER this
             base to win the tie. -->
        <Style Selector="Button.railRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.railSession">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Border.railSession.selected">
            <Setter Property="Background" Value="{StaticResource KcapSelectionBrush}" />
        </Style>
        <Style Selector="Button.railPr">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.railPr /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.railPr:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.railPr:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
        </Style>
        <!-- Hover paints the raised surface, so the open row needs its own background and a
             heavier title to read as selected beside a hovered sibling. No left accent: a
             leading border insets that row's content past its siblings. -->
        <Style Selector="Button.selected">
            <Setter Property="Background" Value="{StaticResource KcapSelectionBrush}" />
        </Style>
        <Style Selector="Button.selected TextBlock.rowTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- Two segments share one line only at the rail's default width or wider. -->
        <Style Selector="Button.railSegmentItem">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.railScopeSegment:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.railPicker">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.railPickerRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button#RailFilterButton.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSelectionBrush}" />
        </Style>
        <Style Selector="TextBlock#RailSearchText">
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="TextBlock#RailSearchText.query">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="TextBlock.footerValue">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.footerMeta">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
        </Style>
        <!-- U+00B7 sits at mid x-height by design, so the glyph centres itself against the
             fragments it separates. It is enlarged by a render transform rather than a FontSize,
             which would give it a taller line box than the row and drop its baseline below the
             fragments'; the transform is laid out at 11 and scaled about the box centre, so the
             glyph grows in place. -->
        <Style Selector="TextBlock.footerDot">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
            <Setter Property="Text" Value="·" />
            <Setter Property="RenderTransform" Value="scale(1.5)" />
        </Style>
        <!-- Status, machine, and age share an 11px line; the logo and glyph sit in that line. -->
        <Style Selector="Border.railChip">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.railChipLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="16" />
        </Style>
        <Style Selector="TextBlock.railMeta">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.railRow:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.railRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSelectionBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource KcapSurfaceBrush}"
            BorderThickness="0,0,1,0" BorderBrush="{StaticResource KcapBorderBrush}">
        <DockPanel Margin="0">
            <StackPanel DockPanel.Dock="Top">
                <!-- 44px chrome row: the macOS traffic lights overlay its left end (the window
                     extends the client area into the title bar). Empty space here drags the
                     window — wired in code-behind. -->
                <Grid Height="44" Background="Transparent" PointerPressed="OnChromePointerPressed">
                    <Button x:Name="CollapseButton" Classes="kcapGhost kcapIcon" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,10,0" Click="OnCollapseClick"
                            ToolTip.Tip="Hide sidebar" AutomationProperties.Name="Hide sidebar">
                        <views:AppIcon Kind="PanelLeftClose" Size="16" Foreground="{StaticResource KcapMutedBrush}" />
                    </Button>
                </Grid>

                <!-- Deselects the workspace: the pane's empty state IS the launcher. -->
                <Button x:Name="RailNewSessionButton" Classes="kcapChip" HorizontalAlignment="Stretch" Margin="10,0,10,10"
                        Command="{Binding NewSessionCommand}"
                        Background="{StaticResource KcapSurfaceRaisedBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                        BorderThickness="1" CornerRadius="7" Padding="11,7" AutomationProperties.Name="New session">
                    <DockPanel>
                        <TextBlock x:Name="RailNewSessionShortcut" DockPanel.Dock="Right" Text="{x:Static views:ShortcutLabels.NewSession}" FontSize="11"
                                   Foreground="{StaticResource KcapFaintBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <views:AppIcon Kind="Plus" Size="14" Foreground="{StaticResource KcapTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="New session" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource KcapTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Button>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="10,0,10,8">
                    <Button x:Name="RailSearchButton" Classes="kcapField" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Command="{Binding OpenSearchCommand}" AutomationProperties.Name="Search sessions">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <TextBlock x:Name="RailSearchText" Text="Search…" FontSize="13"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock x:Name="RailSearchShortcut" Grid.Column="1" Text="{x:Static views:ShortcutLabels.Search}" FontSize="11"
                                       Foreground="{StaticResource KcapFaintBrush}" VerticalAlignment="Center" />
                            <views:AppIcon Grid.Column="2" Kind="Search" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
                        </Grid>
                    </Button>
                    <Button x:Name="RailFilterButton" Grid.Column="1" Classes="kcapGhost kcapIcon"
                            DataContext="{Binding Rail}" x:DataType="vm:SessionRailViewModel"
                            Command="{Binding ToggleFiltersCommand}" Classes.active="{Binding FiltersOpen}"
                            IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Filter sessions" AutomationProperties.Name="Filter sessions">
                        <Panel>
                            <views:AppIcon Kind="ListFilter" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
                            <Ellipse x:Name="RailFilterDot" Width="6" Height="6" Fill="{StaticResource KcapInfoBrush}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                                     IsVisible="{Binding FiltersDiffer}" />
                        </Panel>
                    </Button>
                </Grid>

                <!-- Scope and state are one tap each; grouping and sort open pickers. -->
                <StackPanel x:Name="RailControls" DataContext="{Binding Rail}" x:DataType="vm:SessionRailViewModel"
                            Margin="10,0,10,8" Spacing="6" IsVisible="{Binding FiltersOpen, FallbackValue=False}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border x:Name="RailScopeSegment" Classes="kcapSegment railScopeSegment" HorizontalAlignment="Left"
                                IsEnabled="{Binding CanChangeScope}" ToolTip.Tip="{Binding ScopeTip}" ToolTip.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="RailScopeMineButton" Content="Mine" Classes="kcapSegmentItem railSegmentItem"
                                        Classes.active="{Binding IsMine}" Command="{Binding SetScopeCommand}"
                                        CommandParameter="{x:Static svc:RailScope.Mine}" AutomationProperties.Name="Mine" />
                                <Button x:Name="RailScopeTeamButton" Content="Team" Classes="kcapSegmentItem railSegmentItem"
                                        Classes.active="{Binding IsTeam}" Command="{Binding SetScopeCommand}"
                                        CommandParameter="{x:Static svc:RailScope.Team}" AutomationProperties.Name="Team" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="kcapSegment" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="RailStateAllButton" Content="All" Classes="kcapSegmentItem railSegmentItem"
                                        Classes.active="{Binding IsAll}" Command="{Binding SetStateCommand}"
                                        CommandParameter="{x:Static vm:RailState.All}" AutomationProperties.Name="All sessions" />
                                <Button x:Name="RailStateLiveButton" Content="Live" Classes="kcapSegmentItem railSegmentItem"
                                        Classes.active="{Binding IsLive}" Command="{Binding SetStateCommand}"
                                        CommandParameter="{x:Static vm:RailState.Live}" AutomationProperties.Name="Live sessions" />
                                <Button x:Name="RailStateEndedButton" Content="Ended" Classes="kcapSegmentItem railSegmentItem"
                                        Classes.active="{Binding IsEnded}" Command="{Binding SetStateCommand}"
                                        CommandParameter="{x:Static vm:RailState.Ended}" AutomationProperties.Name="Ended sessions" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- Flexible pickers reserve the direction button and the rail's edge inset. -->
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="4">
                        <Button x:Name="RailGroupButton" Classes="kcapChip railPicker" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip.Tip="Group sessions by"
                                AutomationProperties.Name="Group sessions by">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                                <TextBlock Text="Group" Foreground="{StaticResource KcapMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="RailGroupLabel" Grid.Column="1" Text="{Binding GroupingLabel}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <views:AppIcon Grid.Column="2" Kind="ChevronDown" Size="12" Foreground="{StaticResource KcapMutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" VerticalOffset="4" FlyoutPresenterClasses="kcapPanel">
                                    <StackPanel Spacing="2" Margin="6" MinWidth="160">
                                        <Button Classes="kcapGhost railPickerRow" Content="No grouping" Click="OnGroupPickerItemClick"
                                                Command="{Binding SetGroupingCommand}" CommandParameter="{x:Static vm:RailGrouping.None}" />
                                        <Button Classes="kcapGhost railPickerRow" Content="Repository" Click="OnGroupPickerItemClick"
                                                Command="{Binding SetGroupingCommand}" CommandParameter="{x:Static vm:RailGrouping.Repository}" />
                                        <Button Classes="kcapGhost railPickerRow" Content="Date" Click="OnGroupPickerItemClick"
                                                Command="{Binding SetGroupingCommand}" CommandParameter="{x:Static vm:RailGrouping.Date}" />
                                        <Button Classes="kcapGhost railPickerRow" Content="Status" Click="OnGroupPickerItemClick"
                                                Command="{Binding SetGroupingCommand}" CommandParameter="{x:Static vm:RailGrouping.Status}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="RailSortButton" Grid.Column="1" Classes="kcapChip railPicker" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip.Tip="Sort sessions by"
                                AutomationProperties.Name="Sort sessions by">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                                <TextBlock Text="Sort" Foreground="{StaticResource KcapMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="RailSortLabel" Grid.Column="1" Text="{Binding SortLabel}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <views:AppIcon Grid.Column="2" Kind="ChevronDown" Size="12" Foreground="{StaticResource KcapMutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" VerticalOffset="4" FlyoutPresenterClasses="kcapPanel">
                                    <StackPanel Spacing="2" Margin="6" MinWidth="160">
                                        <Button Classes="kcapGhost railPickerRow" Content="Last updated" Click="OnSortPickerItemClick"
                                                Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:RailSort.LastUpdated}" />
                                        <Button Classes="kcapGhost railPickerRow" Content="Created" Click="OnSortPickerItemClick"
                                                Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:RailSort.Created}" />
                                        <Button Classes="kcapGhost railPickerRow" Content="Title" Click="OnSortPickerItemClick"
                                                Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:RailSort.Title}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="RailDirectionButton" Grid.Column="2" Classes="kcapGhost kcapIcon" Command="{Binding ToggleDirectionCommand}"
                                ToolTip.Tip="{Binding DirectionLabel}" AutomationProperties.Name="{Binding DirectionLabel}">
                            <Panel>
                                <views:AppIcon Kind="ArrowDown" Size="14" Foreground="{StaticResource KcapMutedBrush}" IsVisible="{Binding Descending}" />
                                <views:AppIcon Kind="ArrowUp" Size="14" Foreground="{StaticResource KcapMutedBrush}" IsVisible="{Binding !Descending}" />
                            </Panel>
                        </Button>
                    </Grid>
                </StackPanel>

                <TextBlock Text="Loading sessions…" FontSize="12" Foreground="{StaticResource KcapFaintBrush}"
                           Margin="16,0,16,8" IsVisible="{Binding LoadingSessions}" />
            </StackPanel>

            <!-- Health speaks only when something needs the user; Settings › About holds each
                 component's status and version. The org stays, with its server URL on hover. -->
            <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource KcapBorderBrush}">
                <StackPanel x:Name="RailFooterPanel" Margin="16,10,16,10" Spacing="2">
                    <!-- A daemon launchd holds in the background band throttles every hosted agent; the
                         block offers the reload and keeps its last outcome readable until a success clears it. -->
                    <Border x:Name="RailPriorityBlock" Classes="backgroundPriority" Margin="0,0,0,8" Padding="10,8"
                            CornerRadius="6" Background="{StaticResource KcapWarningDimBrush}"
                            IsVisible="{Binding ShowsReloadBlock}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="RailPriorityText" Text="{Binding BackgroundPriorityText}" TextWrapping="Wrap"
                                       FontSize="12" LineHeight="17" Foreground="{StaticResource KcapWarningBrush}"
                                       IsVisible="{Binding BackgroundPriority}" />
                            <Button x:Name="RailReloadButton" Classes="kcapGhost" Content="Reload" Padding="10,4" FontSize="12.5"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ReloadDaemonCommand}" />
                            <TextBlock x:Name="RailReloadFailureText" Text="{Binding ReloadFailureText}" TextWrapping="Wrap"
                                       FontSize="12" LineHeight="17" Foreground="{StaticResource KcapWarningBrush}"
                                       IsVisible="{Binding ReloadFailureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>
                    <!-- The chip docks beside the column, on its last line. With no alert and no named
                         org the column is empty and the chip stands alone. -->
                    <Grid ColumnDefinitions="*,Auto" ClipToBounds="True">
                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Spacing="6" IsVisible="{Binding !ShowsUpdateContext}">
                    <!-- The words are the indicator, painted in the alert's tone; the hover carries
                         what the one line leaves out. -->
                    <StackPanel x:Name="RailAlertRow" Spacing="6"
                                IsVisible="{Binding Alert, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock x:Name="RailAlertText" Text="{Binding Alert.Text, FallbackValue={x:Null}}" Classes="footerValue"
                                   Foreground="{Binding StatusBrush}" TextWrapping="Wrap"
                                   ToolTip.Tip="{Binding Alert.Detail, FallbackValue={x:Null}}" />
                        <Button x:Name="RailAlertActionButton" Classes="kcapChip" HorizontalAlignment="Left"
                                Content="{Binding Alert.ActionLabel, FallbackValue={x:Null}}"
                                Command="{Binding AlertActionCommand}"
                                AutomationProperties.Name="{Binding Alert.ActionLabel, FallbackValue={x:Null}}"
                                IsVisible="{Binding AlertActionCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Padding="10,3" FontSize="12" CornerRadius="6" />
                    </StackPanel>
                    <TextBlock x:Name="RailTenantText" Text="{Binding TenantName}" Classes="footerValue"
                               Foreground="{StaticResource KcapFaintBrush}" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding TenantName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <ToolTip.Tip>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding ServerUrl}" />
                                <TextBlock Text="{x:Static vm:MainWindowViewModel.ServerUrlTip}"
                                           Classes="kcapTipCaption" />
                            </StackPanel>
                        </ToolTip.Tip>
                    </TextBlock>
                    </StackPanel>
                    <StackPanel x:Name="RailUpdateContext" Grid.Column="0" VerticalAlignment="Center" Spacing="4"
                                IsVisible="{Binding ShowsUpdateContext}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                            <views:AppIcon Kind="Monitor" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding UpdateContextName}" Classes="footerValue"
                                       Foreground="{StaticResource KcapTextBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="5">
                            <TextBlock Text="This machine" Classes="footerMeta" />
                            <TextBlock Grid.Column="1" Classes="footerDot" IsVisible="{Binding DaemonName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Grid.Column="2" Text="{Binding DaemonName}" Classes="footerMeta" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                    <Button x:Name="RailHelpButton" Grid.Column="1" Classes="kcapChip" VerticalAlignment="Bottom"
                            Width="22" Height="22" Padding="0" CornerRadius="6" Margin="10,0,0,0"
                            ToolTip.Tip="Help and support" AutomationProperties.Name="Help and support">
                        <views:AppIcon Kind="CircleQuestionMark" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
                        <Button.Flyout>
                                <!-- Same kcapPanel + ghost rows as the launcher pickers; MenuFlyout
                                     keeps Fluent MenuItem chrome (grey hover bar on this surface). -->
                                <Flyout Placement="TopEdgeAlignedRight" VerticalOffset="6"
                                        FlyoutPresenterClasses="kcapPanel">
                                    <StackPanel Spacing="2" Margin="6" MinWidth="188">
                                        <Button x:Name="RailOpenDashboardButton" Classes="kcapGhost"
                                                Command="{Binding Web.OpenCommand}" Click="OnHelpFlyoutItemClick"
                                                IsVisible="{Binding Web.IsVisible, FallbackValue=False}"
                                                ToolTip.Tip="{Binding Web.Tooltip}" AutomationProperties.Name="{Binding Web.Label}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" FontSize="13.5">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{Binding Web.Label}" VerticalAlignment="Center" />
                                                <views:AppIcon Kind="ExternalLink" Size="14" />
                                            </StackPanel>
                                        </Button>
                                        <Border Height="1" Margin="8,4" Background="{StaticResource KcapBorderBrush}"
                                                IsVisible="{Binding Web.IsVisible, FallbackValue=False}" />
                                        <Button x:Name="RailHelpDocsButton" Classes="kcapGhost" Content="Documentation"
                                                Command="{Binding OpenDocsCommand}" Click="OnHelpFlyoutItemClick"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,8" FontSize="13.5" />
                                        <Button x:Name="RailHelpBugButton" Classes="kcapGhost" Content="Report a bug…"
                                                Command="{Binding OpenFeedbackCommand}" CommandParameter="{x:Static cmd:FeedbackCategory.Bug}"
                                                Click="OnHelpFlyoutItemClick"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,8" FontSize="13.5" />
                                        <Button x:Name="RailHelpFeedbackButton" Classes="kcapGhost" Content="Send feedback…"
                                                Command="{Binding OpenFeedbackCommand}" CommandParameter="{x:Static cmd:FeedbackCategory.Feedback}"
                                                Click="OnHelpFlyoutItemClick"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,8" FontSize="13.5" />
                                        <Border Height="1" Margin="8,4" Background="{StaticResource KcapBorderBrush}">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                    <Binding Path="CanOpenSetup" />
                                                    <Binding Path="SignInVisible" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                        </Border>
                                        <Button x:Name="RailHelpSetupButton" Classes="kcapGhost" Content="Set up kcap…"
                                                Command="{Binding SetupCommand}" Click="OnHelpFlyoutItemClick"
                                                IsVisible="{Binding CanOpenSetup}" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Padding="10,8" FontSize="13.5" />
                                        <Button x:Name="RailHelpSignInButton" Classes="kcapGhost" Content="Sign in"
                                                Command="{Binding SignInCommand}" Click="OnHelpFlyoutItemClick"
                                                IsVisible="{Binding SignInVisible}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,8" FontSize="13.5"
                                                AutomationProperties.Name="Sign in" />
                                        <Button x:Name="LocalSearchSettingsMenuButton" Classes="kcapGhost" Content="Search settings…"
                                                IsVisible="{Binding LocalStack.Search.ShowsInlineSettings, FallbackValue=False}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" FontSize="13.5">
                                            <Button.Flyout>
                                                <Flyout Placement="RightEdgeAlignedBottom" HorizontalOffset="6" FlyoutPresenterClasses="kcapPanel">
                                                    <ScrollViewer MaxHeight="560" Width="440" Margin="16" VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <views:SearchSettingsView DataContext="{Binding LocalStack.Search}" />
                                                    </ScrollViewer>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <StackPanel x:Name="RailAppMenuItems" Spacing="2" IsVisible="{Binding AppMenuInWindow}">
                                            <Border Height="1" Margin="8,4" Background="{StaticResource KcapBorderBrush}" />
                                            <Button x:Name="RailHelpAboutButton" Classes="kcapGhost" Content="About kcap"
                                                    Click="OnAboutClick" IsVisible="{Binding ShowsAbout}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8" FontSize="13.5" />
                                            <Button x:Name="RailHelpCheckForUpdatesButton" Classes="kcapGhost" Content="Check for Updates…"
                                                    Command="{Binding CheckForUpdatesCommand}" Click="OnHelpFlyoutItemClick"
                                                    IsVisible="{Binding ShowsCheckForUpdates}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8" FontSize="13.5" />
                                            <Button x:Name="RailLaunchApprovalsButton" Classes="kcapGhost" Content="Launch approvals…"
                                                    Command="{Binding OpenLaunchApprovalsCommand}" Click="OnHelpFlyoutItemClick"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8" FontSize="13.5" />
                                            <Button x:Name="RailHelpSettingsButton" Classes="kcapGhost" Content="Settings…"
                                                    Command="{Binding OpenSettingsCommand}" Click="OnHelpFlyoutItemClick"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8" FontSize="13.5" />
                                            <Button x:Name="RailHelpUninstallButton" Classes="kcapGhost" Content="Uninstall kcap…"
                                                    Command="{Binding UninstallCommand}" Click="OnHelpFlyoutItemClick"
                                                    IsVisible="{Binding ShowsUninstall}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8" FontSize="13.5" />
                                            <Button x:Name="RailHelpChangelogButton" Classes="kcapGhost" Content="Changelog"
                                                    Command="{Binding OpenChangelogCommand}" Click="OnHelpFlyoutItemClick"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8" FontSize="13.5" />
                                            <TextBlock x:Name="RailAppVersionText" Text="{Binding AppVersionLabel}"
                                                       Foreground="{StaticResource KcapFaintBrush}" FontSize="12" Margin="10,6,10,4" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0,10,4">
                <StackPanel>
                    <TextBlock Text="No sessions" Foreground="{StaticResource KcapFaintBrush}" Margin="8,16"
                               IsVisible="{Binding ShowsNoSessions}" />
                    <ItemsControl x:Name="RailGroups" ItemsSource="{Binding Rail.Groups, FallbackValue={x:Null}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RailGroupViewModel">
                                <StackPanel Margin="8,10,8,0">
                                    <Button Classes="sectionHeader expandable railRepoHeader" Command="{Binding ToggleCommand}" IsVisible="{Binding ShowsHeader}"
                                            ToolTip.Tip="{Binding Tooltip}" AutomationProperties.Name="{Binding ToggleAccessibleName}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="{Binding Label, Converter={x:Static views:UppercaseConverter.Instance}}"
                                                       Classes="eyebrow" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border IsVisible="{Binding ShowsHeaderBadge}" VerticalAlignment="Center" MaxWidth="76">
                                                    <views:AgentStatusMark Classes="railRepoStatus" DataContext="{Binding HeaderStatus}" ToolTip.Tip="{x:Null}" />
                                                </Border>
                                                <TextBlock Text="{Binding CountText}" Classes="sectionMeta" />
                                                <Panel Width="12" Height="12">
                                                    <views:AppIcon Kind="ChevronDown" Size="12" Classes="chevron"
                                                                   IsVisible="{Binding IsExpanded}" />
                                                    <views:AppIcon Kind="ChevronRight" Size="12" Classes="chevron"
                                                                   IsVisible="{Binding !IsExpanded}" />
                                                </Panel>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Border Classes="sectionBody" IsVisible="{Binding IsExpanded}" Padding="8,2,0,2">
                                        <ItemsControl ItemsSource="{Binding Sessions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RailSessionViewModel">
                                                    <Border Classes="railSession" Classes.selected="{Binding IsSelected}" Margin="0,2,0,0"
                                                            Opacity="{Binding IsStale, Converter={x:Static views:StaleOpacityConverter.Instance}}">
                                                        <Grid>
                                                            <Button Command="{Binding OpenCommand}" HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Stretch" Padding="8,6"
                                                                    AutomationProperties.Name="{Binding SessionAccessibleName}"
                                                                    Classes="railRow" Classes.selected="{Binding IsSelected}">
                                                                <ToolTip.Tip>
                                                                    <StackPanel Spacing="10" MaxWidth="320">
                                                                        <views:AgentStatusTip DataContext="{Binding Status}" />
                                                                        <StackPanel Spacing="1" IsVisible="{Binding IsRemote}">
                                                                            <TextBlock Text="{Binding MachineBadge}" TextWrapping="Wrap" />
                                                                            <TextBlock Text="Machine · remote daemon" Classes="kcapTipCaption" />
                                                                        </StackPanel>
                                                                        <StackPanel Spacing="1" IsVisible="{Binding CheckoutPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                            <TextBlock Text="{Binding CheckoutPath}" TextWrapping="Wrap" />
                                                                            <TextBlock Text="Checkout" Classes="kcapTipCaption" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </ToolTip.Tip>
                                                                <StackPanel Spacing="3">
                                                                    <TextBlock Text="{Binding Primary}" FontSize="14.5" LineHeight="20"
                                                                               Classes="rowTitle" IsVisible="{Binding HasTitle}"
                                                                               Foreground="{StaticResource KcapTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <!-- Reserve the measured PR link width so machine and age never paint beneath its hit target. -->
                                                                    <Grid ColumnDefinitions="*,Auto">
                                                                        <WrapPanel VerticalAlignment="Center">
                                                                            <!-- Another user's row shows their picture, or their initials until it loads or when it never does. -->
                                                                            <Border Width="16" Height="16" CornerRadius="8" Margin="0,0,6,0" VerticalAlignment="Center" ClipToBounds="True"
                                                                                    Background="{StaticResource KcapSurfaceRaisedBrush}" BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="1"
                                                                                    IsVisible="{Binding ShowsOwner}" ToolTip.Tip="{Binding OwnerTooltip}" AutomationProperties.Name="{Binding OwnerTooltip}">
                                                                                <Panel>
                                                                                    <TextBlock Text="{Binding OwnerInitials}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                               Foreground="{StaticResource KcapMutedBrush}" />
                                                                                    <views:RemoteAvatar Url="{Binding OwnerAvatarUrl}" AutomationProperties.AccessibilityView="Raw" />
                                                                                </Panel>
                                                                            </Border>
                                                                            <Border Classes="vendorMark" Width="16" Height="16" Margin="0,0,6,0"
                                                                                    VerticalAlignment="Center" Background="Transparent" IsVisible="{Binding HasVendor}"
                                                                                    AutomationProperties.Name="{Binding Vendor, Converter={x:Static views:VendorLabelConverter.Instance}}">
                                                                                <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                Content="{Binding Vendor, Converter={x:Static views:VendorGlyphConverter.Instance}, ConverterParameter=14}" />
                                                                        </Border>
                                                                        <views:AgentStatusMark DataContext="{Binding Status}" MaxWidth="160" ToolTip.Tip="{x:Null}"
                                                                                               Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                        <Border x:Name="SessionMachineBadge" Classes="railChip" IsVisible="{Binding MachineBadge, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                                MaxWidth="140" Margin="0,0,6,0"
                                                                                ToolTip.Tip="{Binding MachineTooltip}" AutomationProperties.Name="{Binding MachineTooltip}">
                                                                            <TextBlock Text="{Binding MachineLabel}" Classes="railChipLabel" TextTrimming="CharacterEllipsis"
                                                                                       Foreground="{StaticResource KcapMutedBrush}" />
                                                                        </Border>
                                                                        <Border Classes="railChip" IsVisible="{Binding IsTerminalSession}" Margin="0,0,6,0"
                                                                                ToolTip.Tip="{x:Static vm:RailSessionViewModel.TerminalTooltip}"
                                                                                AutomationProperties.Name="{x:Static vm:RailSessionViewModel.TerminalTooltip}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                <views:AppIcon Kind="Terminal" Size="12" Foreground="{StaticResource KcapMutedBrush}" VerticalAlignment="Center" />
                                                                                <TextBlock Text="terminal" Classes="railChipLabel" Foreground="{StaticResource KcapMutedBrush}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding RepoLabel}" Classes="railMeta" MaxWidth="140" Margin="0,0,6,0"
                                                                                   IsVisible="{Binding ShowsRepo}" TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{StaticResource KcapMutedBrush}" />
                                                                    <TextBlock x:Name="SessionMeta" Text="{Binding Meta}" Classes="railMeta" MaxWidth="180"
                                                                               IsVisible="{Binding Meta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"
                                                                               Foreground="{StaticResource KcapFaintBrush}" />
                                                                    </WrapPanel>
                                                                    <Border Grid.Column="1" Width="{Binding #SessionPullRequestLink.Bounds.Width}" Margin="8,0,0,0"
                                                                            IsVisible="{Binding HasPullRequest}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Button>
                                                            <Button x:Name="SessionPullRequestLink" Classes="railPr" Command="{Binding OpenPullRequestCommand}" Click="OnPullRequestClick"
                                                                IsVisible="{Binding HasPullRequest}"
                                                                AutomationProperties.Name="{Binding PullRequestAccessibleName}"
                                                                ToolTip.Tip="{Binding PullRequestTooltip}"
                                                                HorizontalAlignment="Right" HorizontalContentAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,4,4"
                                                                FontSize="11" Foreground="{StaticResource KcapMutedBrush}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <views:PullRequestStatusLabel Classes="railPrMark" DataContext="{Binding PullRequestStatus}"
                                                                                              ShowText="False"
                                                                                              IsVisible="{Binding $parent[Button].((vm:RailSessionViewModel)DataContext).HasPullRequestLifecycle}"
                                                                                              VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding PullRequestLabel}" Foreground="{StaticResource KcapMutedBrush}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="RailPaging" DataContext="{Binding Rail}" x:DataType="vm:SessionRailViewModel"
                                Margin="8,8,8,6" Spacing="4" IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Button x:Name="RailShowMoreButton" Classes="kcapGhost" Content="Load more ended sessions" Command="{Binding ShowMoreCommand}"
                                IsVisible="{Binding ShowsShowMore}" HorizontalAlignment="Stretch" Padding="10,5" FontSize="12.5" />
                        <TextBlock x:Name="RailLoadedText" Text="{Binding LoadedText}" Classes="railMeta" Foreground="{StaticResource KcapFaintBrush}"
                                   TextWrapping="Wrap" Margin="8,0" IsVisible="{Binding LoadedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock x:Name="RailCapNote" Text="{x:Static vm:SessionRailViewModel.CapNote}" Classes="railMeta"
                                   Foreground="{StaticResource KcapFaintBrush}" Margin="8,0" TextWrapping="Wrap" IsVisible="{Binding AtCap}" />
                        <TextBlock x:Name="RailLiveNotShownText" Text="{Binding LiveNotShownText}" Classes="railMeta"
                                   Foreground="{StaticResource KcapFaintBrush}" Margin="8,0" TextWrapping="Wrap"
                                   IsVisible="{Binding LiveNotShownText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
