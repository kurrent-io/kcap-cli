<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             xmlns:cmd="clr-namespace:Capacitor.Cli.Core.Commands;assembly=Capacitor.Cli.Core"
             x:Class="Capacitor.App.Views.SessionRailView"
             x:DataType="vm:MainWindowViewModel">
    <!-- DataContext is INHERITED from the window (never assigned here), so Rail is null on any
         window built without one — every Rail.* binding below carries a fallback for that. -->
    <UserControl.Styles>
        <!-- A row's resting Background and BorderThickness MUST come from this class style, never a
             local attribute on the Button: a local value outranks a style trigger, which would leave
             the highlight styles below permanently inert (and suppress the theme's hover/pressed
             feedback). Avalonia has no CSS specificity, so the highlights are declared AFTER this
             base to win the tie. -->
        <Style Selector="Button.railRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="Button.holdsSelected">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
        </Style>
        <!-- Hover paints the raised surface, so the open row needs its own background and a
             heavier title to read as selected beside a hovered sibling. No left accent: a
             leading border insets that row's content past its siblings. -->
        <Style Selector="Button.selected">
            <Setter Property="Background" Value="{StaticResource KcapSelectionBrush}" />
        </Style>
        <Style Selector="Button.selected TextBlock.rowTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.footerValue">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.footerMeta">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
        </Style>
        <Style Selector="TextBlock.footerMeta.restartPending">
            <Setter Property="Foreground" Value="{StaticResource KcapWarningBrush}" />
        </Style>
        <!-- U+00B7 sits at mid x-height by design, so the glyph centres itself against the
             fragments it separates. It is enlarged by a render transform rather than a FontSize,
             which would give it a taller line box than the row and drop its baseline below the
             fragments'; the transform is laid out at 11 and scaled about the box centre, so the
             glyph grows in place. -->
        <Style Selector="TextBlock.footerDot">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
            <Setter Property="Text" Value="·" />
            <Setter Property="RenderTransform" Value="scale(1.5)" />
        </Style>
        <Style Selector="WrapPanel#RailDaemonRow > TextBlock">
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <!-- Centred on the 11px line, the glyph lands a pixel under the word. The same
             translateY(-1px) lifts an icon that sits beside a label. -->
        <Style Selector="Panel.glyph, Border.vendorMark">
            <Setter Property="RenderTransform" Value="translateY(-1px)" />
        </Style>
        <!-- The worktree row's marks sit on 13.5px and 12px text, whose glyphs centre 1.5px above
             the line box. The lift goes on a box: a Shape's own RenderTransform is a local value. -->
        <Style Selector="Panel.branchMark, Panel.chevronBox">
            <Setter Property="RenderTransform" Value="translateY(-1.5px)" />
        </Style>
        <!-- Status word and the age share one 11px line. The logo and glyph sit in that line;
             chip padding stays on the chip, not on the age, or the age drops below the line. -->
        <Style Selector="Border.railChip">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.railChipLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="16" />
        </Style>
        <Style Selector="TextBlock.railMeta">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.railRow:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.railRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.holdsSelected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.holdsSelected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSelectionBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource KcapSurfaceBrush}"
            BorderThickness="0,0,1,0" BorderBrush="{StaticResource KcapBorderBrush}">
        <DockPanel Margin="0">
            <StackPanel DockPanel.Dock="Top">
                <!-- 44px chrome row: the macOS traffic lights overlay its left end (the window
                     extends the client area into the title bar). Empty space here drags the
                     window — wired in code-behind. -->
                <Grid Height="44" Background="Transparent" PointerPressed="OnChromePointerPressed" />

                <!-- Deselects the workspace: the pane's empty state IS the launcher. -->
                <Button x:Name="RailNewSessionButton" Classes="kcapChip" HorizontalAlignment="Stretch" Margin="10,0,10,10"
                        Command="{Binding CloseWorkspaceCommand}"
                        Background="{StaticResource KcapSurfaceRaisedBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                        BorderThickness="1" CornerRadius="7" Padding="11,7">
                    <DockPanel>
                        <TextBlock x:Name="RailNewSessionShortcut" DockPanel.Dock="Right" Text="{x:Static views:ShortcutLabels.NewSession}" FontSize="11"
                                   Foreground="{StaticResource KcapFaintBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="+" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource KcapTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="New session" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource KcapTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Button>
            </StackPanel>

            <!-- Two rows split by what each fact belongs to: the org and how we stand with it,
                 then the daemon on this machine and what it is running. The server URL rides the
                 org's hover — at rail width it wraps to two lines and outweighs its neighbours. -->
            <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource KcapBorderBrush}">
                <StackPanel x:Name="RailFooterPanel" Margin="16,10,16,10" Spacing="2">
                    <!-- A daemon launchd holds in the background band throttles every hosted agent; the
                         block offers the reload and keeps its last outcome readable until a success clears it. -->
                    <Border x:Name="RailPriorityBlock" Classes="backgroundPriority" Margin="0,0,0,8" Padding="10,8"
                            CornerRadius="6" Background="{StaticResource KcapWarningDimBrush}"
                            IsVisible="{Binding ShowsReloadBlock}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="RailPriorityText" Text="{Binding BackgroundPriorityText}" TextWrapping="Wrap"
                                       FontSize="12" LineHeight="17" Foreground="{StaticResource KcapWarningBrush}"
                                       IsVisible="{Binding BackgroundPriority}" />
                            <Button x:Name="RailReloadButton" Classes="kcapGhost" Content="Reload" Padding="10,4" FontSize="12.5"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ReloadDaemonCommand}" />
                            <TextBlock x:Name="RailReloadFailureText" Text="{Binding ReloadFailureText}" TextWrapping="Wrap"
                                       FontSize="12" LineHeight="17" Foreground="{StaticResource KcapWarningBrush}"
                                       IsVisible="{Binding ReloadFailureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="RailConnectionStatus" Orientation="Horizontal" Spacing="7">
                        <!-- Extra info (lighter) then the fragment's name (kcapTipCaption). A
                             diagnostic takes the extra slot; without one the caption stands
                             alone at default colour, same as daemon / agents / help. -->
                        <ToolTip.Tip>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding ServerLaneTip}" TextWrapping="Wrap"
                                           IsVisible="{Binding ConnectionHasDetail}" />
                                <TextBlock Text="{x:Static vm:MainWindowViewModel.AttachStatusTip}"
                                           Classes="kcapTipCaption"
                                           IsVisible="{Binding ConnectionHasDetail}" />
                                <TextBlock Text="{x:Static vm:MainWindowViewModel.AttachStatusTip}"
                                           IsVisible="{Binding !ConnectionHasDetail}" />
                            </StackPanel>
                        </ToolTip.Tip>
                        <!-- The word IS the indicator: it takes StatusBrush itself, so the status
                             colour needs no disc with a line box of its own to align against.
                             Both fragments draw their size from footerValue and override only the
                             brush, so the row cannot end up with two sizes and two baselines. -->
                        <TextBlock Text="{Binding ConnectionDisplay}" Classes="footerValue"
                                   Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="RailTenantText" Text="{Binding TenantName}" Classes="footerValue"
                                   Foreground="{StaticResource KcapFaintBrush}" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding TenantName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <ToolTip.Tip>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding ServerUrl}" />
                                    <TextBlock Text="{x:Static vm:MainWindowViewModel.ServerUrlTip}"
                                               Classes="kcapTipCaption" />
                                </StackPanel>
                            </ToolTip.Tip>
                        </TextBlock>
                    </StackPanel>
                    <!-- ClipToBounds plus WrapPanel: a horizontal StackPanel sizes children
                         unbounded, so a long daemon line paints into the help chip. -->
                    <DockPanel ClipToBounds="True">
                        <Button x:Name="RailHelpButton" DockPanel.Dock="Right" Classes="kcapChip"
                                Width="22" Height="22" Padding="0" CornerRadius="6" Margin="10,0,0,0"
                                ToolTip.Tip="Help and support" AutomationProperties.Name="Help and support"
                                VerticalAlignment="Bottom">
                            <PathIcon Width="14" Height="14" Foreground="{StaticResource KcapMutedBrush}"
                                      Data="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm0 1.8a7.2 7.2 0 1 1 0 14.4 7.2 7.2 0 0 1 0-14.4zm0 3.2a3 3 0 0 0-3 3h1.8a1.2 1.2 0 1 1 1.7 1.1c-.9.4-1.4 1.1-1.4 2.2h1.8c0-.5.2-.8.7-1a3 3 0 0 0-1.6-5.3zM11 15.5v1.8h1.8v-1.8z" />
                            <Button.Flyout>
                                <!-- Same kcapPanel + ghost rows as the launcher pickers; MenuFlyout
                                     keeps Fluent MenuItem chrome (grey hover bar on this surface). -->
                                <Flyout Placement="TopEdgeAlignedRight" VerticalOffset="6"
                                        FlyoutPresenterClasses="kcapPanel">
                                    <StackPanel Spacing="2" Margin="6" MinWidth="188">
                                        <Button x:Name="RailHelpSignInButton" Classes="kcapGhost" Content="Sign in"
                                                Command="{Binding SignInCommand}" Click="OnHelpFlyoutItemClick"
                                                IsVisible="{Binding SignInVisible}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,8" FontSize="13.5"
                                                AutomationProperties.Name="Sign in" />
                                        <Border Height="1" Margin="8,4" Background="{StaticResource KcapBorderBrush}"
                                                IsVisible="{Binding SignInVisible}" />
                                        <Button x:Name="RailHelpDocsButton" Classes="kcapGhost" Content="Documentation"
                                                Command="{Binding OpenDocsCommand}" Click="OnHelpFlyoutItemClick"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,8" FontSize="13.5" />
                                        <Button x:Name="RailHelpBugButton" Classes="kcapGhost" Content="Report a bug…"
                                                Command="{Binding OpenFeedbackCommand}" CommandParameter="{x:Static cmd:FeedbackCategory.Bug}"
                                                Click="OnHelpFlyoutItemClick"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,8" FontSize="13.5" />
                                        <Button x:Name="RailHelpFeedbackButton" Classes="kcapGhost" Content="Send feedback…"
                                                Command="{Binding OpenFeedbackCommand}" CommandParameter="{x:Static cmd:FeedbackCategory.Feedback}"
                                                Click="OnHelpFlyoutItemClick"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,8" FontSize="13.5" />
                                        <StackPanel x:Name="RailAppMenuItems" Spacing="2" IsVisible="{Binding AppMenuInWindow}">
                                            <Border Height="1" Margin="8,4" Background="{StaticResource KcapBorderBrush}" />
                                            <Button x:Name="RailHelpSettingsButton" Classes="kcapGhost" Content="Settings…"
                                                    Command="{Binding OpenSettingsCommand}" Click="OnHelpFlyoutItemClick"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8" FontSize="13.5" />
                                            <Button x:Name="RailHelpChangelogButton" Classes="kcapGhost" Content="Changelog"
                                                    Command="{Binding OpenChangelogCommand}" Click="OnHelpFlyoutItemClick"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8" FontSize="13.5" />
                                            <TextBlock x:Name="RailAppVersionText" Text="{Binding AppVersionLabel}"
                                                       Foreground="{StaticResource KcapFaintBrush}" FontSize="12" Margin="10,6,10,4" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!-- Bottom, not Center: the fragments and the button share the row's
                             bottom edge, so the text line and the button agree on one line. One
                             font size across the row, so the baselines coincide outright.
                             Each dot repeats the visibility of the fragment to its RIGHT, so a
                             fragment takes its separator with it rather than leaving it dangling. -->
                        <WrapPanel x:Name="RailDaemonRow" VerticalAlignment="Bottom">
                            <TextBlock x:Name="RailDaemonNameText" Text="{Binding DaemonName}" Classes="footerMeta"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{x:Static vm:MainWindowViewModel.DaemonNameTip}"
                                       IsVisible="{Binding DaemonName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="footerDot"
                                       IsVisible="{Binding VersionDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock x:Name="RailVersionText" Text="{Binding VersionDisplay}" Classes="footerMeta"
                                       Classes.restartPending="{Binding RestartPending}"
                                       IsVisible="{Binding VersionDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <ToolTip.Tip>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding RestartPendingText}" TextWrapping="Wrap"
                                                   IsVisible="{Binding RestartPending}" />
                                        <TextBlock Text="{x:Static vm:MainWindowViewModel.VersionIdentityTip}"
                                                   Classes="kcapTipCaption"
                                                   IsVisible="{Binding RestartPending}" />
                                        <TextBlock Text="{x:Static vm:MainWindowViewModel.VersionIdentityTip}"
                                                   IsVisible="{Binding !RestartPending}" />
                                    </StackPanel>
                                </ToolTip.Tip>
                            </TextBlock>
                            <TextBlock Classes="footerDot"
                                       IsVisible="{Binding AgentCountText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock x:Name="RailAgentCountText" Text="{Binding AgentCountText}" Classes="footerMeta"
                                       ToolTip.Tip="{x:Static vm:MainWindowViewModel.AgentCountTip}"
                                       IsVisible="{Binding AgentCountText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </WrapPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0,10,4">
                <Panel>
                    <TextBlock Text="No sessions" Foreground="{StaticResource KcapFaintBrush}" Margin="8,16"
                               IsVisible="{Binding Rail.IsEmpty, FallbackValue=False}" />
                    <ItemsControl x:Name="RailRepos" ItemsSource="{Binding Rail.Repos, FallbackValue={x:Null}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RailRepoViewModel">
                                <StackPanel Margin="0,10,0,0">
                                    <DockPanel Margin="8,0,8,5" ToolTip.Tip="{Binding RootDisplay}">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="12"
                                                   Foreground="{StaticResource KcapFaintBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label, Converter={x:Static views:UppercaseConverter.Instance}}"
                                                   FontSize="12" FontWeight="Bold" LetterSpacing="1.2"
                                                   Foreground="{StaticResource KcapFaintBrush}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="Work with no checkout yet. It keeps a title and a session; parts and blockers arrive once it lands in a repo."
                                               FontSize="12" LineHeight="17" Foreground="{StaticResource KcapFaintBrush}"
                                               TextWrapping="Wrap" Margin="8,0,8,4"
                                               IsVisible="{Binding IsNoRepository}" />
                                    <ItemsControl ItemsSource="{Binding Worktrees}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RailWorktreeViewModel">
                                                <StackPanel>
                                                    <Button Command="{Binding ToggleCommand}" IsVisible="{Binding ShowHeader}"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                            Padding="8,6" Margin="0,2,0,0"
                                                            ToolTip.Tip="{Binding Tooltip}"
                                                            Classes="railRow" Classes.holdsSelected="{Binding HoldsSelected}">
                                                        <!-- Fixed status and count columns, so every row's title gets the same width and
                                                             the statuses line up down the rail. 76 fits "Needs you", the longest word. -->
                                                        <Grid ColumnDefinitions="Auto,*,76,Auto" ColumnSpacing="8">
                                                            <!-- Branch glyph: two commits and a fork, stroked to read at 12px. Its
                                                                 colour is the worktree's pull request state; plain when it has none. -->
                                                            <Panel Classes="branchMark" VerticalAlignment="Center">
                                                                <Path Stroke="{Binding PullRequestTone, Converter={x:Static views:PullRequestToneBrushConverter.Instance}}"
                                                                      StrokeThickness="1.5" views:PulseClock.IsActive="{Binding ChecksRunning}"
                                                                      Width="12" Height="12" Stretch="Uniform"
                                                                      Data="M3.3,3 A1.3,1.3 0 1 0 3.3,5.6 A1.3,1.3 0 1 0 3.3,3 M3.3,9 A1.3,1.3 0 1 0 3.3,11.6 A1.3,1.3 0 1 0 3.3,9 M9,4 A1.3,1.3 0 1 0 9,6.6 A1.3,1.3 0 1 0 9,4 M3.3,5.6 L3.3,9 M9,6.6 C9,8.6 3.3,7.6 3.3,9" />
                                                            </Panel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13.5"
                                                                       Foreground="{StaticResource KcapMutedBrush}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <Border Grid.Column="2" IsVisible="{Binding ShowsHeaderBadge}" VerticalAlignment="Center">
                                                                <views:AgentStatusMark DataContext="{Binding HeaderStatus}" />
                                                            </Border>
                                                            <!-- The count's box has a floor so a two-digit count does not push the status column. -->
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CountText}" FontSize="12" MinWidth="14" TextAlignment="Right"
                                                                           Foreground="{StaticResource KcapFaintBrush}" VerticalAlignment="Center" />
                                                                <!-- Stroked chevron, not a text glyph — the 9px ▸ rendered as a dot. -->
                                                                <Panel Classes="chevronBox" Width="12" Height="12" VerticalAlignment="Center">
                                                                    <Path Stroke="{StaticResource KcapMutedBrush}" StrokeThickness="1.8"
                                                                          StrokeLineCap="Round" StrokeJoin="Round"
                                                                          Data="M3,4.5 L6,7.5 L9,4.5" IsVisible="{Binding IsExpanded}" />
                                                                    <Path Stroke="{StaticResource KcapMutedBrush}" StrokeThickness="1.8"
                                                                          StrokeLineCap="Round" StrokeJoin="Round"
                                                                          Data="M4.5,3 L7.5,6 L4.5,9" IsVisible="{Binding !IsExpanded}" />
                                                                </Panel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                    <!-- The indent's guide-line: sessions hang off their worktree visually,
                                                         not just by margin. -->
                                                    <Border BorderThickness="1,0,0,0" BorderBrush="{StaticResource KcapBorderBrush}"
                                                            Margin="14,0,0,0" Padding="6,0,0,0"
                                                            IsVisible="{Binding SessionsVisible}">
                                                        <ItemsControl ItemsSource="{Binding Sessions}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:RailSessionViewModel">
                                                                    <Button Command="{Binding OpenCommand}" HorizontalAlignment="Stretch"
                                                                            HorizontalContentAlignment="Stretch"
                                                                            Padding="8,6" Margin="0,2,0,0"
                                                                            Opacity="{Binding IsStale, Converter={x:Static views:StaleOpacityConverter.Instance}}"
                                                                            Classes="railRow" Classes.selected="{Binding IsSelected}">
                                                                        <ToolTip.Tip>
                                                                            <views:AgentStatusTip DataContext="{Binding Status}" />
                                                                        </ToolTip.Tip>
                                                                        <StackPanel Spacing="3">
                                                                            <!-- Title stands alone on its line; a plain TextBlock in this vertical
                                                                                 StackPanel is width-bounded, so CharacterEllipsis engages. When the
                                                                                 row has no title the chips line below is the row's identity. -->
                                                                            <TextBlock Text="{Binding Primary}" FontSize="14.5" LineHeight="20"
                                                                                       Classes="rowTitle" IsVisible="{Binding HasTitle}"
                                                                                       Foreground="{StaticResource KcapTextBrush}"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <!-- The age sits on the right. Vendor, status and machine stay on the left
                                                                                 and wrap rather than overflow the 330px rail. A WrapPanel measures
                                                                                 each child unconstrained, and the age column is measured first, so
                                                                                 each has a cap. The row's one tip is the status tip; no child carries
                                                                                 its own, so hovering anywhere on the row shows the same one. -->
                                                                            <Grid ColumnDefinitions="*,Auto">
                                                                            <WrapPanel VerticalAlignment="Center">
                                                                                <Border Classes="vendorMark" Width="16" Height="16" Margin="0,0,6,0"
                                                                                        VerticalAlignment="Center" Background="Transparent"
                                                                                        IsVisible="{Binding HasVendor}"
                                                                                        AutomationProperties.Name="{Binding Vendor, Converter={x:Static views:VendorLabelConverter.Instance}}">
                                                                                    <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                    Content="{Binding Vendor, Converter={x:Static views:VendorGlyphConverter.Instance}, ConverterParameter=14}" />
                                                                                </Border>
                                                                                <views:AgentStatusMark DataContext="{Binding Status}" MaxWidth="160"
                                                                                                       ToolTip.Tip="{x:Null}"
                                                                                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                                <Border Classes="railChip" IsVisible="{Binding MachineBadge, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                                        Background="{StaticResource KcapSurfaceRaisedBrush}" MaxWidth="100"
                                                                                        CornerRadius="3" Padding="4,2" Margin="0,0,6,0">
                                                                                    <TextBlock Text="{Binding MachineBadge}" Classes="railChipLabel"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               Foreground="{StaticResource KcapFaintBrush}" />
                                                                                </Border>
                                                                            </WrapPanel>
                                                                                <TextBlock Grid.Column="1" Text="{Binding Meta}" Classes="railMeta"
                                                                                           MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                                                           Margin="8,0,0,0" HorizontalAlignment="Right"
                                                                                           Foreground="{StaticResource KcapFaintBrush}" />
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
