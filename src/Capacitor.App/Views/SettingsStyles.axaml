<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <SolidColorBrush x:Key="SettingsControlBorderBrush" Color="#616B80" />
    </Styles.Resources>
    <!-- Keep native tab selection and keyboard navigation, with a rail that can grow
         independently of the selected section. All chrome uses the app palette. -->
    <Style Selector="TabControl.settingsSidebar">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="200,*">
                    <Border Background="{StaticResource KcapSurfaceBrush}"
                            BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="0,0,1,0">
                        <Grid RowDefinitions="Auto,*" Margin="12,24,12,16">
                            <TextBlock Classes="settingsEyebrow" Text="Settings" Margin="10,0,0,10" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <!-- No margin here: each page pads inside its own ScrollViewer, so the
                         scrollbar sits at the window edge instead of over the content. -->
                    <ContentPresenter Grid.Column="1" Name="PART_SelectedContentHost"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch"
                                      Content="{TemplateBinding SelectedContent}"
                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabItem.settingsNav">
        <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter" CornerRadius="8"
                                  Background="{TemplateBinding Background}"
                                  Foreground="{TemplateBinding Foreground}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  Padding="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="Center"
                                  RecognizesAccessKey="True" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabItem.settingsNav:pointerover">
        <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
    </Style>
    <Style Selector="TabItem.settingsNav:selected">
        <Setter Property="Background" Value="{StaticResource KcapSelectionBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KcapInfoBrush}" />
    </Style>
    <Style Selector="TabItem.settingsNav:focus-visible">
        <Setter Property="BorderBrush" Value="{StaticResource KcapInfoBrush}" />
    </Style>
    <Style Selector="StackPanel.settingsPage">
        <Setter Property="Margin" Value="28,28,28,32" />
        <Setter Property="MaxWidth" Value="680" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="StackPanel.settingsPage">
        <Setter Property="Spacing" Value="24" />
    </Style>
    <!-- A save bar pinned under a page that has explicit Save, so the action is never scrolled away. -->
    <Style Selector="Border.settingsActionBar">
        <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Background" Value="{StaticResource KcapCanvasBrush}" />
        <Setter Property="Padding" Value="28,12" />
    </Style>
    <Style Selector="Border.settingsContextChip">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.settingsFieldLabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
    </Style>
    <!-- Sections share the content's left edge; separators give structure without nested cards. -->
    <Style Selector="Border.settingsSection">
        <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,0,0,24" />
    </Style>
    <Style Selector="Grid.settingsRow">
        <Setter Property="Margin" Value="0,16" />
    </Style>
    <Style Selector="Border.settingsDivider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource KcapBorderBrush}" />
    </Style>
    <Style Selector="TextBlock.settingsEyebrow">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.8" />
        <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
    </Style>
    <Style Selector="Border.settingsCard">
        <Setter Property="Background" Value="{StaticResource KcapSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="TabControl.settingsSidebar TextBlock.kcapTitle">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="31" />
        <Setter Property="LetterSpacing" Value="-0.5" />
    </Style>
    <Style Selector="TabControl.settingsSidebar TextBlock.kcapSubtitle">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LetterSpacing" Value="0" />
    </Style>
    <Style Selector="TabControl.settingsSidebar TextBlock.kcapLabel">
        <Setter Property="FontSize" Value="13.5" />
    </Style>
    <Style Selector="TabControl.settingsSidebar TextBlock.kcapHint">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="LetterSpacing" Value="0" />
    </Style>
    <Style Selector="TabControl.settingsSidebar TextBox.kcapField">
        <Setter Property="FontSize" Value="13.5" />
    </Style>
    <Style Selector="CheckBox.settingsHarnessCheck">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="12,0,0,0" />
    </Style>
    <Style Selector="TabControl.settingsSidebar TextBox.kcapField,
                     TabControl.settingsSidebar ComboBox.kcapField,
                     TabControl.settingsSidebar NumericUpDown.kcapField">
        <Setter Property="BorderBrush" Value="{StaticResource SettingsControlBorderBrush}" />
    </Style>
    <Style Selector="TabControl.settingsSidebar TextBox.kcapField /template/ Border#PART_BorderElement,
                     TabControl.settingsSidebar TextBox.kcapField:pointerover /template/ Border#PART_BorderElement,
                     TabControl.settingsSidebar ComboBox.kcapField /template/ Border#Background,
                     TabControl.settingsSidebar ComboBox.kcapField:pointerover /template/ Border#Background,
                     TabControl.settingsSidebar ComboBox.kcapField:pressed /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{StaticResource SettingsControlBorderBrush}" />
    </Style>
    <Style Selector="TabControl.settingsSidebar TextBox.kcapField:focus /template/ Border#PART_BorderElement,
                     TabControl.settingsSidebar ComboBox.kcapField:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{StaticResource KcapInfoBrush}" />
    </Style>
    <Style Selector="TabControl.settingsSidebar NumericUpDown.kcapField:focus-within">
        <Setter Property="BorderBrush" Value="{StaticResource KcapInfoBrush}" />
    </Style>
</Styles>
