<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
        x:Class="Capacitor.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Kurrent Capacitor — Settings"
        Icon="avares://Kurrent Capacitor/Assets/kcap-icon.png"
        Width="540" Height="580" CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource KcapCanvasBrush}">
    <Grid Margin="28,20" RowDefinitions="*,Auto">
        <TabControl x:Name="SettingsTabs" Classes="kcapSettingsTabs" SelectedIndex="0">
            <TabItem x:Name="DaemonTab" Classes="kcapSettingsTab" Header="Daemon">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock x:Name="DaemonTitleText" Classes="kcapTitle" Text="Daemon"
                                           VerticalAlignment="Center" LineHeight="22" />
                                <Border x:Name="StatusChip" Grid.Column="1" Padding="10,5" CornerRadius="999"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource KcapSurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="1"
                                        ToolTip.Tip="{Binding StatusTip}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="StatusCaptionText" Text="Agents" FontSize="11" FontWeight="Medium"
                                                   LetterSpacing="0.2" Foreground="{StaticResource KcapMutedBrush}"
                                                   VerticalAlignment="Center" IsVisible="{Binding StatusShowsAgents}" />
                                        <TextBlock x:Name="StatusText" Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold"
                                                   LetterSpacing="0.2" Foreground="{StaticResource KcapTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Classes="kcapSubtitle"
                                       Text="Hosted agents and reviews run through this daemon. Rename and capacity each save on their own."
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="kcapLabel" Text="Name" />
                                    <TextBlock Classes="kcapHint" TextWrapping="Wrap"
                                               Text="How this machine identifies itself to the server. Renaming restarts the daemon and relaunches this app." />
                                </StackPanel>
                                <TextBox x:Name="NameInput" Classes="kcapField" Text="{Binding Name, Mode=TwoWay}"
                                         IsEnabled="{Binding CanEdit}" />
                                <TextBlock x:Name="NameErrorText" Classes="kcapHint" Text="{Binding NameError}"
                                           TextWrapping="Wrap" Foreground="{StaticResource KcapDangerBrush}"
                                           IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <Button x:Name="RenameButton" Classes="kcapPrimary" Content="Rename"
                                        Command="{Binding RenameCommand}" HorizontalAlignment="Left"
                                        ToolTip.Tip="{Binding RenameHint}"
                                        ToolTip.ShowOnDisabled="True" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="kcapLabel" Text="Capacity" />
                                    <TextBlock Classes="kcapHint" TextWrapping="Wrap"
                                               Text="Maximum agents running at once. 0 is unlimited. Agents already running keep going if you lower the limit." />
                                </StackPanel>
                                <NumericUpDown x:Name="CapacityInput" Classes="kcapField" Width="160" HorizontalAlignment="Left"
                                               Value="{Binding Capacity, Mode=TwoWay}"
                                               Minimum="0" Maximum="2147483647" Increment="1" FormatString="0"
                                               IsEnabled="{Binding CanEdit}" />
                                <TextBlock x:Name="CapacityErrorText" Classes="kcapHint" Text="{Binding CapacityError}"
                                           TextWrapping="Wrap" Foreground="{StaticResource KcapDangerBrush}"
                                           IsVisible="{Binding CapacityError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <Button x:Name="SaveButton" Classes="kcapPrimary" Content="Save" Command="{Binding SaveCommand}"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="NotificationsTab" Classes="kcapSettingsTab" Header="Notifications">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="kcapTitle" Text="Notifications" LineHeight="22" />
                            <TextBlock Classes="kcapSubtitle" TextWrapping="Wrap"
                                       Text="Shown only while Kurrent Capacitor is in the background. Your operating system must also allow notifications." />
                        </StackPanel>

                        <Border x:Name="NotificationAccessNotice"
                                Background="{StaticResource KcapWarningDimBrush}" BorderBrush="{StaticResource KcapWarningBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20,14"
                                IsVisible="{Binding NotificationAccessText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                <TextBlock x:Name="NotificationAccessText" Classes="kcapHint" TextWrapping="Wrap"
                                           Text="{Binding NotificationAccessText}"
                                           Foreground="{StaticResource KcapWarningBrush}" VerticalAlignment="Center" />
                                <Button x:Name="NotificationAccessButton" Grid.Column="1" Classes="kcapChip"
                                        Content="{Binding NotificationAccessAction}"
                                        Command="{Binding NotificationAccessCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="kcapLabel" Text="Permission requests" />
                                    <TextBlock Classes="kcapHint" TextWrapping="Wrap"
                                               Text="When an agent needs approval to use a tool or take an action." />
                                </StackPanel>
                                <ToggleSwitch x:Name="PermissionNotificationsToggle" Grid.Column="1" Classes="kcapSwitch"
                                              IsChecked="{Binding NotifyOnPermissions, Mode=TwoWay}"
                                              IsEnabled="{Binding CanManageNotifications}"
                                              AutomationProperties.Name="Permission request notifications"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="kcapLabel" Text="Questions" />
                                    <TextBlock Classes="kcapHint" TextWrapping="Wrap"
                                               Text="When an agent asks you for an answer." />
                                </StackPanel>
                                <ToggleSwitch x:Name="QuestionNotificationsToggle" Grid.Column="1" Classes="kcapSwitch"
                                              IsChecked="{Binding NotifyOnQuestions, Mode=TwoWay}"
                                              IsEnabled="{Binding CanManageNotifications}"
                                              AutomationProperties.Name="Question notifications"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="kcapLabel" Text="Waiting for you" />
                                    <TextBlock Classes="kcapHint" TextWrapping="Wrap"
                                               Text="When an agent finishes a turn and is waiting for you." />
                                </StackPanel>
                                <ToggleSwitch x:Name="IdleNotificationsToggle" Grid.Column="1" Classes="kcapSwitch"
                                              IsChecked="{Binding NotifyOnIdle, Mode=TwoWay}"
                                              IsEnabled="{Binding CanManageNotifications}"
                                              AutomationProperties.Name="Waiting agent notifications"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock x:Name="NotificationMessageText" Classes="kcapHint"
                                   Text="{Binding NotificationMessage}" TextWrapping="Wrap"
                                   Foreground="{StaticResource KcapDangerBrush}"
                                   IsVisible="{Binding NotificationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1" x:Name="MessageText" Classes="kcapHint" Text="{Binding Message}" TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </Grid>
</Window>
