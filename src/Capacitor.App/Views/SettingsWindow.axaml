<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
        x:Class="Capacitor.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Icon="avares://Kurrent Capacitor/Assets/kcap-icon.png"
        Width="540" Height="610" CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource KcapCanvasBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock x:Name="DaemonTitleText" Classes="kcapTitle" Text="Daemon" />
                <TextBlock x:Name="StatusText" Classes="kcapSubtitle" Text="{Binding StatusLine}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Classes="kcapLabel" Text="Name" />
                    <TextBox x:Name="NameInput" Classes="kcapField" Text="{Binding Name, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                    <TextBlock Text="{Binding NameError}" TextWrapping="Wrap" Foreground="{StaticResource KcapDangerBrush}"
                               FontSize="12" LetterSpacing="0.2"
                               IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Classes="kcapHint" Text="{Binding RenameHint}" TextWrapping="Wrap" />
                    <Button x:Name="RenameButton" Classes="kcapChip" Content="Rename and restart daemon"
                            Command="{Binding RenameCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Classes="kcapLabel" Text="Capacity" />
                    <TextBlock Classes="kcapHint"
                               Text="Maximum agents running at once, or 0 for unlimited. Existing agents keep running when you lower this limit."
                               TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="12">
                        <NumericUpDown x:Name="CapacityInput" Classes="kcapField" Value="{Binding Capacity, Mode=TwoWay}"
                                       Minimum="0" Maximum="2147483647" Increment="1" FormatString="0"
                                       IsEnabled="{Binding CanEdit}" />
                        <Button Grid.Column="2" x:Name="SaveButton" Classes="kcapPrimary" Content="Save"
                                Command="{Binding SaveCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding CapacityError}" TextWrapping="Wrap" Foreground="{StaticResource KcapDangerBrush}"
                               FontSize="12" LetterSpacing="0.2"
                               IsVisible="{Binding CapacityError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="MessageText" Classes="kcapHint" Text="{Binding Message}" TextWrapping="Wrap"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</Window>
