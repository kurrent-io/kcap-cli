<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             x:Class="Capacitor.App.Views.PageViewer"
             x:DataType="vm:PageViewerViewModel"
             Background="{StaticResource KcapCanvasBrush}">
    <Grid RowDefinitions="Auto,Auto,*">
        <Border BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock x:Name="PageTitle" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                <Button x:Name="OpenInBrowser" Grid.Column="1" Classes="kcapGhost" Content="Open in browser"
                        Command="{Binding OpenInBrowserCommand}" />
            </Grid>
        </Border>
        <Border x:Name="PendingBar" Grid.Row="1" IsVisible="{Binding HasPending}" Padding="24,8"
                Background="{StaticResource KcapWarningDimBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock x:Name="PendingPrompt" Text="{Binding PendingPrompt}" ToolTip.Tip="{Binding PendingExternalUrl}"
                           FontSize="12.5" Foreground="{StaticResource KcapWarningBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="OpenPending" Grid.Column="1" Classes="kcapGhost" Content="Open"
                        Command="{Binding OpenPendingCommand}" />
                <Button x:Name="DismissPending" Grid.Column="2" Classes="kcapGhost" Content="Dismiss"
                        Command="{Binding DismissPendingCommand}" />
            </Grid>
        </Border>
        <TextBlock x:Name="PageNotice" Grid.Row="2" Text="{Binding Notice}" IsVisible="{Binding !IsReady}"
                   Margin="24,20" FontSize="13" Foreground="{StaticResource KcapMutedBrush}" TextWrapping="Wrap" />
        <ContentControl x:Name="WebHost" Grid.Row="2" IsVisible="{Binding IsReady}" />
    </Grid>
</UserControl>
