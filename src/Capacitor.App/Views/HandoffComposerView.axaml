<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             x:Class="Capacitor.App.Views.HandoffComposerView"
             x:DataType="vm:HandoffComposerViewModel">
    <Border x:Name="HandoffCard" Classes="attachTarget"
            Background="{StaticResource KcapSurfaceRaisedBrush}"
            BorderThickness="1" CornerRadius="10" Padding="13,10,13,12">
        <StackPanel Spacing="8">
            <!-- Where the new session would start, and what of the old one's work it may lack. -->
            <StackPanel x:Name="HandoffStrip" Spacing="6">
                <TextBlock x:Name="HandoffStripLabel" Text="{Binding StripLabel}" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{StaticResource KcapMutedBrush}"
                           IsVisible="{Binding StripLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <views:LaunchChipsView x:Name="HandoffChips" DataContext="{Binding Choices}" />
                <StackPanel x:Name="HandoffCompleteness" Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding WorkMissingOrUnconfirmed}">
                    <views:AppIcon Kind="TriangleAlert" Size="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource KcapWarningBrush}" />
                    <TextBlock Text="{Binding CompletenessNote}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{StaticResource KcapMutedBrush}" />
                </StackPanel>
            </StackPanel>

            <views:AttachmentChipStrip x:Name="HandoffChipStrip" Tray="{Binding Tray}"
                                       IsVisible="{Binding Tray.HasAttachments}" />
            <TextBox x:Name="HandoffInput" Classes="kcapEmbedded" Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="44" MaxHeight="160" Padding="0"
                     PlaceholderText="What should the new session do next?" />

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button x:Name="HandoffAttachButton" Classes="kcapGhost"
                        IsEnabled="{Binding CanAttach}" ToolTip.Tip="{Binding AttachHint}"
                        ToolTip.ShowOnDisabled="True" AutomationProperties.Name="Attach files"
                        Width="24" Height="24" Padding="0" Cursor="Hand" Margin="0,0,10,0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <views:AppIcon Kind="Paperclip" Size="16" />
                </Button>
                <TextBlock x:Name="HandoffNotice" Grid.Column="1" Text="{Binding Notice}" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{StaticResource KcapFaintBrush}" VerticalAlignment="Center"
                           IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button x:Name="StartHandoffButton" Grid.Column="2" Classes="kcapPrimary" Content="Start hand-off"
                        Command="{Binding StartCommand}" Margin="12,0,0,0"
                        Height="24" Padding="12,0" VerticalContentAlignment="Center" FontSize="13" FontWeight="SemiBold" CornerRadius="7"
                        Background="{StaticResource KcapPrimaryBrush}" Foreground="{StaticResource KcapOnPrimaryBrush}"
                        IsVisible="{Binding DisabledReason, Converter={x:Static ObjectConverters.IsNull}}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
