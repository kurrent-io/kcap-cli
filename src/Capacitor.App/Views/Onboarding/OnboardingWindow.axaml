<rxui:ReactiveWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:rxui="clr-namespace:ReactiveUI.Avalonia;assembly=ReactiveUI.Avalonia"
                     xmlns:vm="clr-namespace:Capacitor.App.ViewModels.Onboarding"
                     xmlns:views="clr-namespace:Capacitor.App.Views.Onboarding"
                     x:Class="Capacitor.App.Views.Onboarding.OnboardingWindow"
                     x:TypeArguments="vm:OnboardingViewModel"
                     x:DataType="vm:OnboardingViewModel"
                     Title="Kurrent Capacitor — Setup"
                     Icon="avares://Kurrent Capacitor/Assets/kcap-icon.png"
                     Width="640" Height="580"
                     MinWidth="560" MinHeight="480"
                     CanResize="True"
                     Background="{StaticResource KcapCanvasBrush}">
    <Window.Styles>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter,
                         ComboBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="Background" Value="{StaticResource KcapBorderBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
        </Style>
    </Window.Styles>
    <!-- Per-step templates, selected by ViewModel type; the ContentControl below deliberately
         sets no ContentTemplate, which would win over every one of these. -->
    <Window.DataTemplates>
        <DataTemplate DataType="vm:ConnectStepViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="kcapSubtitle"
                           Text="You'll sign in on the next step. Choose how to reach a workspace."
                           TextWrapping="Wrap" />

                <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16,12">
                    <StackPanel Spacing="8">
                        <RadioButton x:Name="DiscoverChoice" GroupName="Connect" Content="Find workspaces for my account"
                                     IsChecked="{Binding DiscoverSelected, Mode=TwoWay}" />

                        <RadioButton x:Name="PasteChoice" GroupName="Connect" Content="Enter a workspace name or URL"
                                     IsChecked="{Binding PasteSelected, Mode=TwoWay}" />
                        <StackPanel Margin="28,0,0,4" Spacing="4" IsVisible="{Binding PasteSelected}">
                            <TextBox x:Name="ServerInputBox" Classes="kcapField" PlaceholderText="acme  ·  https://acme.kcap.ai"
                                     Text="{Binding ServerInputText, Mode=TwoWay}" />
                            <TextBlock x:Name="ConnectErrorText" Text="{Binding InputError}" TextWrapping="Wrap"
                                       Foreground="{StaticResource KcapDangerBrush}" FontSize="12" LetterSpacing="0.2"
                                       IsVisible="{Binding InputError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <RadioButton x:Name="CreateChoice" GroupName="Connect" Content="Create a new workspace"
                                     IsChecked="{Binding CreateSelected, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:SignInStepViewModel">
            <views:SignInStepView />
        </DataTemplate>

        <DataTemplate DataType="vm:ShimStepViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="kcapSubtitle"
                           Text="{Binding Disclosure}"
                           TextWrapping="Wrap" />

                <Button x:Name="InstallShimButton" Classes="kcapPrimary" Content="Install" Command="{Binding InstallCommand}"
                        IsEnabled="{Binding Idle}" HorizontalAlignment="Left" />

                <TextBlock x:Name="ShimSuccessText" Classes="kcapHint" Text="kcap is now on your terminal PATH."
                           IsVisible="{Binding Satisfied}" />

                <TextBlock x:Name="ShimMessageText" Text="{Binding Message}" TextWrapping="Wrap"
                           Foreground="{StaticResource KcapDangerBrush}" FontSize="12" LetterSpacing="0.2"
                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:DefaultsStepViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="kcapSubtitle"
                           Text="Who can see sessions you start here, and what this machine is called."
                           TextWrapping="Wrap" />

                <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="kcapLabel" Text="Who can see new sessions" />
                            <ComboBox x:Name="VisibilityCombo" Classes="kcapField"
                                      ItemsSource="{x:Static vm:DefaultsStepViewModel.VisibilityOptions}"
                                      SelectedValueBinding="{Binding Value}" SelectedValue="{Binding Visibility, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" MaxDropDownHeight="280">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="VisibilityLabelText" Text="{Binding Label}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource KcapTextBrush}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Border x:Name="PublicNoticeBanner" IsVisible="{Binding PublicSelected}"
                                    Background="{StaticResource KcapWarningDimBrush}"
                                    BorderBrush="{StaticResource KcapWarningBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10">
                                <TextBlock x:Name="PublicNoticeText"
                                           Text="{x:Static vm:DefaultsStepViewModel.PublicNotice}"
                                           TextWrapping="Wrap" FontSize="12" LineHeight="18" LetterSpacing="0.2"
                                           Foreground="{StaticResource KcapWarningBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Classes="kcapLabel" Text="Name" />
                            <TextBlock Classes="kcapHint" Text="How this machine identifies itself to the server."
                                       TextWrapping="Wrap" />
                            <TextBox x:Name="DaemonNameBox" Classes="kcapField" Text="{Binding DaemonName, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="DefaultsMessageText" Text="{Binding Message}" TextWrapping="Wrap"
                           Foreground="{StaticResource KcapDangerBrush}" FontSize="12" LetterSpacing="0.2"
                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:AgentsStepViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="kcapSubtitle" Text="Install kcap's hooks into the agents you use. You can skip any you don't want."
                           TextWrapping="Wrap" />

                <TextBlock x:Name="AgentsMessageText" Text="{Binding Message}" TextWrapping="Wrap"
                           Foreground="{StaticResource KcapDangerBrush}" FontSize="12" LetterSpacing="0.2"
                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16,12">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="kcapLabel" Text="Agents" />
                        <ItemsControl x:Name="AgentsList" ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="220" ItemSpacing="8" LineSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <CheckBox x:Name="AgentCheckBox" Content="{Binding Label}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                            <TextBlock x:Name="AgentGlyphText" Text="{Binding Glyph}" FontWeight="Bold"
                                                       VerticalAlignment="Center" Foreground="{StaticResource KcapMutedBrush}" />
                                        </StackPanel>
                                        <Button x:Name="AgentRetryButton" Grid.Column="1" Classes="kcapChip" Content="Retry"
                                                Command="{Binding RetryCommand}" IsVisible="{Binding Failed}"
                                                VerticalAlignment="Center" />
                                        <TextBlock x:Name="AgentRowMessageText" Grid.Row="1" Grid.ColumnSpan="2"
                                                   Classes="kcapHint" Text="{Binding Message}" TextWrapping="Wrap"
                                                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Button x:Name="InstallAgentsButton" Classes="kcapPrimary" Content="Install" Command="{Binding InstallCommand}"
                        HorizontalAlignment="Left" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:ImportStepViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="kcapSubtitle"
                           Text="Bring existing agent sessions into Capacitor. Skip if you want to start fresh."
                           TextWrapping="Wrap" />

                <TextBlock x:Name="ImportMessageText" Text="{Binding Message}" TextWrapping="Wrap"
                           Foreground="{StaticResource KcapDangerBrush}" FontSize="12" LetterSpacing="0.2"
                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16,12">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="kcapLabel" Text="Agents" />
                        <ItemsControl x:Name="ImportVendorsList" ItemsSource="{Binding Vendors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="220" ItemSpacing="8" LineSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="ImportVendorCheckBox" Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16,12">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="kcapLabel" Text="What to import" />
                        <RadioButton x:Name="EverythingChoice" GroupName="ImportScope" Content="All sessions from those agents"
                                     IsChecked="{Binding EverythingSelected, Mode=TwoWay}" />
                        <RadioButton x:Name="OrgChoice" GroupName="ImportScope" Content="One organization"
                                     IsChecked="{Binding OrgSelected, Mode=TwoWay}" />
                        <TextBox x:Name="OrgTextBox" Classes="kcapField" PlaceholderText="acme"
                                 Text="{Binding OrgText, Mode=TwoWay}" IsVisible="{Binding OrgSelected}" />
                        <RadioButton x:Name="RepoChoice" GroupName="ImportScope" Content="One repository"
                                     IsChecked="{Binding RepoSelected, Mode=TwoWay}" />
                        <TextBox x:Name="RepoTextBox" Classes="kcapField" PlaceholderText="owner/name"
                                 Text="{Binding RepoText, Mode=TwoWay}" IsVisible="{Binding RepoSelected}" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RunImportButton" Classes="kcapPrimary" Content="Import" Command="{Binding RunCommand}" />
                    <Button x:Name="CancelImportButton" Classes="kcapChip" Content="Cancel" Command="{Binding CancelCommand}"
                            IsVisible="{Binding Busy}" />
                    <TextBlock x:Name="ImportStatusText" Classes="kcapHint" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="ImportTruncationText" Classes="kcapHint" Text="…older lines dropped" FontStyle="Italic"
                           IsVisible="{Binding Truncated}" />
                <ItemsControl x:Name="ImportLog" ItemsSource="{Binding Log}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontSize="12" LetterSpacing="0.2"
                                       Foreground="{StaticResource KcapMutedBrush}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:DaemonStepViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="kcapSubtitle"
                           Text="Runs hosted agents and reviews in the background. Starts again after a reboot."
                           TextWrapping="Wrap" />

                <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock x:Name="DaemonMessageText" Text="{Binding Message}" TextWrapping="Wrap"
                                   FontSize="13.5" LineHeight="21" Foreground="{StaticResource KcapTextBrush}"
                                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <Button x:Name="DaemonActionButton" Classes="kcapPrimary" Content="{Binding ActionLabel}"
                                Command="{Binding ActionCommand}" HorizontalAlignment="Left"
                                IsVisible="{Binding ActionLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <Button x:Name="DaemonRefreshButton" Classes="kcapChip" Content="Check again"
                                Command="{Binding RefreshCommand}" HorizontalAlignment="Left"
                                IsVisible="{Binding RefreshVisible}" />

                        <TextBlock x:Name="DaemonStatusText" Classes="kcapHint" Text="{Binding Status}" TextWrapping="Wrap"
                                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:DoneStepViewModel">
            <StackPanel Spacing="14">
                <TextBlock Classes="kcapSubtitle"
                           Text="Here's what this machine is set up for. Change any of this later in Settings."
                           TextWrapping="Wrap" />

                <Border Background="{StaticResource KcapSurfaceBrush}" BorderBrush="{StaticResource KcapBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="8">
                    <ItemsControl x:Name="SummaryList" ItemsSource="{Binding Summary}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="12,10">
                                    <Grid Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <Border CornerRadius="11" Background="{StaticResource KcapSuccessDimBrush}"
                                                IsVisible="{Binding Satisfied}" />
                                        <Border CornerRadius="11" Background="{StaticResource KcapSurfaceRaisedBrush}"
                                                BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="1"
                                                IsVisible="{Binding Incomplete}" />
                                        <TextBlock x:Name="SummaryGlyphText" Text="{Binding Glyph}" FontSize="11"
                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource KcapSuccessBrush}"
                                                   IsVisible="{Binding Satisfied}" />
                                        <TextBlock Text="–" FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource KcapMutedBrush}"
                                                   IsVisible="{Binding Incomplete}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="SummaryTitleText" Classes="kcapLabel" Text="{Binding Title}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="SummaryNoteText" Classes="kcapHint" Text="{Binding Detail}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid Margin="28,24" RowDefinitions="Auto,*,Auto">
        <!-- Fallback presenter: always shows the current step's title, template or not. -->
        <TextBlock Grid.Row="0" x:Name="StepTitleText" Classes="kcapTitle" Text="{Binding Current.Title}"
                   LetterSpacing="-0.3" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" x:Name="StepScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="StepContent" Content="{Binding Current}" HorizontalAlignment="Stretch" />
        </ScrollViewer>

        <!-- Left of the buttons: the outcome consumer's lines. Wizard-first mode has no tray and
             no main window, so this footer is where a lane outcome actually becomes visible. -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
            <Button x:Name="BackButton" Classes="kcapChip" Content="Back" Command="{Binding BackCommand}"
                    VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="12,0">
                <TextBlock x:Name="LifecycleStatusText" Classes="kcapHint" Text="{Binding Surface.StatusText}" TextWrapping="Wrap"
                           IsVisible="{Binding Surface.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock x:Name="LifecycleAttentionText" Text="{Binding Surface.AttentionText}" TextWrapping="Wrap"
                           Foreground="{StaticResource KcapDangerBrush}" FontSize="12" LetterSpacing="0.2"
                           IsVisible="{Binding Surface.AttentionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                        VerticalAlignment="Center">
                <Button x:Name="SkipButton" Classes="kcapChip" Content="Skip" Command="{Binding SkipCommand}"
                        IsVisible="{Binding SkipVisible}" />
                <Button x:Name="NextButton" Classes="kcapPrimary" Content="{Binding NextLabel}" Command="{Binding NextCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</rxui:ReactiveWindow>
