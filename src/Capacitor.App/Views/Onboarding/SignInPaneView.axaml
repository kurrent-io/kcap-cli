<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:auth="clr-namespace:Capacitor.Cli.Core.Auth;assembly=Capacitor.Cli.Core"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels.Onboarding"
             xmlns:views="clr-namespace:Capacitor.App.Views.Onboarding"
             xmlns:icons="clr-namespace:Capacitor.App.Views"
             x:Class="Capacitor.App.Views.Onboarding.SignInPaneView"
             x:DataType="vm:SignInStepViewModel">
    <StackPanel Spacing="16">
        <Border Classes="frCard" IsVisible="{Binding SignUpPanelVisible}">
            <StackPanel Spacing="16">
                <Button x:Name="ContinueAfterSignUpButton" Classes="frPrimary" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Content="Continue"
                        Command="{Binding ContinueAfterSignUpCommand}" />
                <TextBlock Classes="frNote" Text="Continue finds your new workspace and signs this Mac in to it." />

                <StackPanel Spacing="4" IsVisible="{Binding StatusLineVisible}">
                    <TextBlock x:Name="SignUpStatusText" Classes="frLabel" Text="{Binding Status}" TextWrapping="Wrap"
                               Classes.failed="{Binding StatusIsError}">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock.failed">
                                <Setter Property="Foreground" Value="{StaticResource KcapDangerBrush}" />
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                    <TextBlock Classes="frBody" Text="{Binding StatusDetail}"
                               IsVisible="{Binding StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="ReopenSignUpButton" Classes="frLink" Margin="0,0,24,0"
                            Content="Open the sign-up page again" Command="{Binding ReopenSignUpCommand}" />
                    <Button x:Name="SignUpUseCodeButton" Classes="frLink" Margin="0,0,24,0" Content="Use a sign-in code"
                            Command="{Binding UseCodeCommand}" />
                    <Button x:Name="SignUpWorkspaceUrlButton" Classes="frLink" Content="Use a workspace URL"
                            Command="{Binding ToggleUrlPanelCommand}" />
                </WrapPanel>

                <StackPanel Spacing="8" IsVisible="{Binding UrlPanelVisible}">
                    <TextBlock Classes="frLabel" Text="Workspace name or URL" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox x:Name="SignUpServerInputBox" Classes="frField" PlaceholderText="acme  ·  https://acme.kcap.ai"
                                 AutomationProperties.Name="Workspace name or URL"
                                 Text="{Binding Connect.ServerInputText, Mode=TwoWay}" />
                        <Button Grid.Column="1" x:Name="SignUpContinueWithUrlButton" Classes="frSecondary" Content="Continue"
                                Command="{Binding ContinueWithUrlCommand}" />
                    </Grid>
                    <TextBlock Classes="frError" Text="{Binding Connect.InputError}"
                               IsVisible="{Binding Connect.InputError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="frCard" IsVisible="{Binding StartPanelVisible}">
            <StackPanel Spacing="16">
                <Button x:Name="WorkAccountButton" Classes="frPrimary" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Content="{Binding WorkAccountLabel}"
                        Command="{Binding ContinueWithWorkAccountCommand}"
                        IsEnabled="{Binding Idle}" IsVisible="{Binding ShowPrimaryAction}" />
                <TextBlock Classes="frNote" Text="Sign in securely in your browser. You'll return here to finish setup."
                           IsVisible="{Binding ShowPrimaryAction}" />

                <StackPanel Spacing="4" IsVisible="{Binding Satisfied}">
                    <Border Classes="frResolved">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:AppIcon Kind="Check" Size="14" VerticalAlignment="Center" Foreground="{StaticResource KcapSuccessBrush}" />
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="StartSignedInText" Classes="frLabel" Text="{Binding ConnectionStatus}" />
                                <TextBlock Classes="frBody" Text="{Binding StatusDetail}"
                                           IsVisible="{Binding StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding StatusLineVisible}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Panel Classes="frSpinner" IsVisible="{Binding Busy}">
                            <icons:AppIcon Kind="LoaderCircle" Size="20" Classes.kcapSpinning="{Binding Busy}"
                                           Foreground="{StaticResource FrAccentBrush}" />
                        </Panel>
                        <TextBlock x:Name="SignInStatusText" Classes="frLabel" Text="{Binding Status}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Classes.failed="{Binding StatusIsError}">
                            <TextBlock.Styles>
                                <Style Selector="TextBlock.failed">
                                    <Setter Property="Foreground" Value="{StaticResource KcapDangerBrush}" />
                                </Style>
                            </TextBlock.Styles>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock x:Name="SignInDetailText" Classes="frBody" Text="{Binding StatusDetail}"
                               IsVisible="{Binding StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <Border Classes="frCallout" IsVisible="{Binding BrowserUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="frMicro" Text="BROWSER DIDN'T OPEN?" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Button x:Name="OpenSignInUrlButton" Classes="frLink" Content="Open browser"
                                    Command="{Binding OpenSignInUrlCommand}" />
                            <Button x:Name="CopySignInUrlButton" Classes="frLink" Content="Copy sign-in link" Click="OnCopySignInUrlClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="frCallout" IsVisible="{Binding DeviceCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="frMicro" Text="ENTER THIS CODE TO FINISH SIGNING IN" />
                        <TextBlock x:Name="DeviceCodeText" Text="{Binding DeviceCode}" FontSize="28" FontWeight="Bold"
                                   LetterSpacing="3" FontFamily="{StaticResource FrMonoFont}"
                                   Foreground="{StaticResource KcapTextBrush}" />
                        <Button x:Name="OpenVerificationUriButton" Classes="frLink" HorizontalAlignment="Left"
                                Content="{Binding VerificationUri}" Command="{Binding OpenVerificationUriCommand}" />
                        <Button Classes="frLink" HorizontalAlignment="Left" Content="Copy code" Click="OnCopyDeviceCodeClick" />
                    </StackPanel>
                </Border>

                <WrapPanel Orientation="Horizontal" IsVisible="{Binding ShowPrimaryAction}">
                    <Button x:Name="UseCodeButton" Classes="frLink" Margin="0,0,24,0" Content="Use a sign-in code"
                            Command="{Binding UseCodeCommand}" />
                    <Button x:Name="WorkspaceUrlButton" Classes="frLink" Content="Use a workspace URL"
                            Command="{Binding ToggleUrlPanelCommand}" />
                </WrapPanel>
                <Button x:Name="CancelSignInButton" Classes="frLink" HorizontalAlignment="Left" Content="Cancel sign-in"
                        Command="{Binding CancelCommand}" IsVisible="{Binding Busy}" />

                <StackPanel Spacing="8" IsVisible="{Binding UrlPanelVisible}" IsEnabled="{Binding Idle}">
                    <TextBlock Classes="frLabel" Text="Workspace name or URL" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox x:Name="ServerInputBox" Classes="frField" PlaceholderText="acme  ·  https://acme.kcap.ai"
                                 AutomationProperties.Name="Workspace name or URL"
                                 Text="{Binding Connect.ServerInputText, Mode=TwoWay}" />
                        <Button Grid.Column="1" x:Name="ContinueWithUrlButton" Classes="frSecondary" Content="Continue"
                                Command="{Binding ContinueWithUrlCommand}" IsEnabled="{Binding Idle}" />
                    </Grid>
                    <TextBlock x:Name="ConnectErrorText" Classes="frError" Text="{Binding Connect.InputError}"
                               IsVisible="{Binding Connect.InputError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="frCard" IsVisible="{Binding TenantPickerVisible}">
            <StackPanel Spacing="14">
                <TextBlock Classes="frMicro" Text="WORKSPACES FOR YOUR ACCOUNT" />
                <ListBox x:Name="TenantList" Classes="frList" ItemsSource="{Binding Tenants}"
                         SelectedItem="{Binding SelectedTenant, Mode=TwoWay}"
                         IsEnabled="{Binding TenantChoicePending}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="auth:DiscoveredTenant">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="frLabel" Text="{Binding Label}" />
                                    <TextBlock Classes="frSignal" Text="{Binding Origin}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <icons:AppIcon Kind="Check" Size="14" Grid.Column="1" Classes="frChoiceMark" VerticalAlignment="Center"
                                               Foreground="{StaticResource FrAccentBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Classes="frResolved" IsVisible="{Binding Satisfied}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:AppIcon Kind="Check" Size="14" VerticalAlignment="Center" Foreground="{StaticResource KcapSuccessBrush}" />
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="SignedInText" Classes="frLabel" Text="{Binding ConnectionStatus}" />
                            <TextBlock Classes="frBody" Text="{Binding StatusDetail}"
                                       IsVisible="{Binding StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Classes="frWarning" IsVisible="{Binding QuarantineNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Spacing="10">
                <TextBlock x:Name="QuarantineNoticeText" Classes="frBody" Text="{Binding QuarantineNotice}" />
                <Button x:Name="AcknowledgeQuarantineButton" Classes="frSecondary" HorizontalAlignment="Left"
                        Content="Acknowledge" Command="{Binding AcknowledgeQuarantineCommand}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
