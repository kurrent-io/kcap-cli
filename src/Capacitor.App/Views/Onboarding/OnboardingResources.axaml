<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The installer and onboarding share the kcap brand's plum, lavender and coral palette.
         Onboarding-prefixed resources keep this treatment separate from the main desktop theme. -->
    <SolidColorBrush x:Key="OnboardingCanvasBrush" Color="#180F19" />
    <SolidColorBrush x:Key="OnboardingTextBrush" Color="#DED9FF" />
    <SolidColorBrush x:Key="OnboardingFieldBrush" Color="#1E1220" />
    <SolidColorBrush x:Key="OnboardingAccentBrush" Color="#DED9FF" />
    <SolidColorBrush x:Key="OnboardingAccentHoverBrush" Color="#EEEAFE" />
    <SolidColorBrush x:Key="OnboardingAccentOnBrush" Color="#631B3A" />
    <SolidColorBrush x:Key="OnboardingAccentWashBrush" Color="#1ADED9FF" />
    <SolidColorBrush x:Key="OnboardingAtmosphereBrush" Color="#FF4A80" />
    <SolidColorBrush x:Key="OnboardingMutedBrush" Color="#C3B5C7" />
    <SolidColorBrush x:Key="OnboardingDimBrush" Color="#AD9AB2" />
    <SolidColorBrush x:Key="OnboardingNeutralBrush" Color="#C7BBCD" />
    <SolidColorBrush x:Key="OnboardingSurfaceBrush" Color="#2A1B2D" />
    <SolidColorBrush x:Key="OnboardingSurfaceBorderBrush" Color="#5D4363" />
    <SolidColorBrush x:Key="OnboardingControlBorderBrush" Color="#7D6384" />
    <SolidColorBrush x:Key="OnboardingDividerBrush" Color="#17DED9FF" />
    <SolidColorBrush x:Key="OnboardingPanelBorderBrush" Color="#5D4363" />
    <SolidColorBrush x:Key="OnboardingSkeletonBrush" Color="#3A2540" />
    <SolidColorBrush x:Key="OnboardingWarningFillBrush" Color="#0DFF7272" />
    <SolidColorBrush x:Key="OnboardingWarningBorderBrush" Color="#47FF7272" />
    <SolidColorBrush x:Key="OnboardingResolvedFillBrush" Color="#0D5BE0B3" />
    <SolidColorBrush x:Key="OnboardingResolvedBorderBrush" Color="#425BE0B3" />
    <RadialGradientBrush x:Key="OnboardingBloomBrush" GradientOrigin="50%,50%" Center="50%,50%" RadiusX="50%" RadiusY="50%">
        <GradientStop Offset="0" Color="#8C631B3A" />
        <GradientStop Offset="0.4" Color="#38631B3A" />
        <GradientStop Offset="0.7" Color="#00631B3A" />
    </RadialGradientBrush>
    <FontFamily x:Key="OnboardingMonoFont">Menlo,Monaco,Consolas,Cascadia Mono,DejaVu Sans Mono,monospace</FontFamily>
</ResourceDictionary>
