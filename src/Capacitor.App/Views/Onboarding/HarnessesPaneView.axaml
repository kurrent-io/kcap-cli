<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels.Onboarding"
             xmlns:views="clr-namespace:Capacitor.App.Views.Onboarding"
             xmlns:icons="clr-namespace:Capacitor.App.Views"
             x:Class="Capacitor.App.Views.Onboarding.HarnessesPaneView"
             x:DataType="vm:HarnessesStepViewModel">
    <StackPanel Spacing="14">
        <Border x:Name="PrivacyCard" Classes="frCard" IsVisible="{Binding VisibilityVisible}">
            <StackPanel Spacing="8">
                <TextBlock Classes="frMicro" Text="WHO CAN READ NEW SESSIONS" />
                <TextBlock Classes="frDetail" Text="Choose a privacy setting before continuing, even if you connect your harnesses later." />
                <TextBlock Classes="frNote" Text="{Binding CurrentVisibilityNote}"
                           IsVisible="{Binding CurrentVisibilityNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="frDetail">
                    <Run Text="Applies to sessions recorded on " /><Run Text="{Binding MachineName}" FontFamily="{StaticResource FrMonoFont}"
                        Foreground="{StaticResource KcapTextBrush}" /><Run Text=". Sessions can still be shared or hidden individually." />
                </TextBlock>
                <ItemsControl x:Name="VisibilityOptions" ItemsSource="{x:Static vm:HarnessesStepViewModel.VisibilityOptions}"
                              IsEnabled="{Binding Idle}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:VisibilityOption">
                            <RadioButton Classes="frOption" GroupName="Visibility" Margin="0,0,0,2"
                                         Tag="{Binding Value}" IsCheckedChanged="OnVisibilityChecked"
                                         Loaded="OnVisibilityLoaded" AutomationProperties.Name="{Binding Label}"
                                         AutomationProperties.HelpText="{Binding Detail}">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="frLabel" FontSize="13" Text="{Binding Label}" />
                                    <TextBlock Classes="frDetail" Text="{Binding Detail}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Border Classes="frCard">
            <StackPanel Spacing="12">
                <TextBlock x:Name="HarnessesMessageText" Classes="frError" Text="{Binding CliMissingNote}"
                           IsVisible="{Binding !CliAvailable}" />

                <StackPanel Spacing="14" IsVisible="{Binding IsDetecting}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource FrAccentWashBrush}">
                            <Panel Classes="frSpinner">
                                <icons:AppIcon Kind="LoaderCircle" Size="20" Classes.kcapSpinning="{Binding IsDetecting}"
                                               Foreground="{StaticResource FrAccentBrush}" />
                            </Panel>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="frLabel" FontSize="15" Text="Looking for harnesses" />
                            <TextBlock Classes="frBody" FontSize="13">
                                <Run Text="on " /><Run Text="{Binding MachineName}" FontFamily="{StaticResource FrMonoFont}" /><Run Text=" — usually a moment" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <Border Height="44" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource FrPanelBorderBrush}"
                                Background="{StaticResource FrSkeletonBrush}" Classes="pulsing" />
                        <Border Height="44" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource FrPanelBorderBrush}"
                                Background="{StaticResource FrSkeletonBrush}" Classes="pulsing" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Classes="frBody" IsVisible="{Binding NoneFound}">
                    <Run Text="No harnesses were found on " /><Run Text="{Binding MachineName}" FontFamily="{StaticResource FrMonoFont}"
                        Foreground="{StaticResource KcapTextBrush}" /><Run Text=". Install a harness, then reopen setup from Help and support." />
                </TextBlock>

                <!-- The table: one row per detected harness, record and tools in fixed cells. -->
                <StackPanel IsVisible="{Binding ShowsTable}">
                    <Border Classes="frRowRule" Padding="0,0,0,8">
                        <Grid ColumnDefinitions="*,68,68">
                            <TextBlock Classes="frMicro">
                                <Run Text="FOUND ON " /><Run Text="{Binding MachineName}" Foreground="{StaticResource KcapTextBrush}" />
                            </TextBlock>
                            <TextBlock Grid.Column="1" Classes="frMicro" Text="RECORD" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="frMicro" Text="TOOLS" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="HarnessRows" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HarnessRowViewModel">
                                <Border Classes="frRowRule" Padding="2,11">
                                    <StackPanel Spacing="6">
                                        <!-- The box shares the name's row. The line under the name must not pull it down. -->
                                        <Grid ColumnDefinitions="*,Auto,68,68" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Row="0" x:Name="HarnessLabelText" Classes="frLabel" VerticalAlignment="Center"
                                                       Text="{Binding Label}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="frSignal" Margin="0,2,0,0"
                                                       Text="{Binding SignalLine}" />
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Classes="frSignal" Text="installing…" IsVisible="{Binding Installing}" />
                                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding Succeeded}">
                                                    <icons:AppIcon Kind="Check" Size="12" Foreground="{StaticResource KcapSuccessBrush}" />
                                                    <TextBlock Classes="frSignal" Text="turned on" Foreground="{StaticResource KcapSuccessBrush}" />
                                                </StackPanel>
                                                <Button x:Name="HarnessRetryButton" Classes="frSecondary frCompact" Content="Retry"
                                                        Command="{Binding RetryCommand}" IsVisible="{Binding Failed}" />
                                            </StackPanel>
                                            <CheckBox Grid.Row="0" Grid.Column="2" x:Name="RecordCheckBox" Classes="frCheck"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsEnabled="{Binding $parent[UserControl].((vm:HarnessesStepViewModel)DataContext).ChoicesEditable}"
                                                      IsChecked="{Binding Record, Mode=TwoWay}"
                                                      ToolTip.Tip="{Binding Label, StringFormat='Record {0} sessions'}"
                                                      AutomationProperties.Name="{Binding Label, StringFormat='Record {0} sessions'}" />
                                            <CheckBox Grid.Row="0" Grid.Column="3" x:Name="ToolsCheckBox" Classes="frCheck"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsEnabled="{Binding $parent[UserControl].((vm:HarnessesStepViewModel)DataContext).ChoicesEditable}"
                                                      IsChecked="{Binding Tools, Mode=TwoWay}" IsVisible="{Binding !ToolsBundled}"
                                                      ToolTip.Tip="{Binding Label, StringFormat='Give {0} Capacitor tools'}"
                                                      AutomationProperties.Name="{Binding Label, StringFormat='Give {0} Capacitor tools'}" />
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="BUNDLED" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FrMonoFont}" FontSize="9" LetterSpacing="0.6"
                                                       Foreground="{StaticResource FrDimBrush}" IsVisible="{Binding ToolsBundled}" />
                                        </Grid>
                                        <TextBlock Classes="frDetail" Text="{Binding ConsentNote}" Margin="0,0,152,0"
                                                   IsVisible="{Binding ConsentNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock x:Name="HarnessRowMessageText" Classes="frError" Text="{Binding Message}"
                                                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="frNote" Text="{Binding NotFoundLine}" Margin="0,11,0,0"
                               IsVisible="{Binding NotFoundLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <!-- A provider key in the terminal: kcap scrubs it from headless spawns unless told not to. -->
                <Border Classes="frCallout" IsVisible="{Binding ProviderKeyNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <CheckBox x:Name="ProviderKeyCheckBox" Classes="frCheck" VerticalAlignment="Top" Margin="0,1,0,0"
                                  IsChecked="{Binding UseProviderApiKey, Mode=TwoWay}" IsEnabled="{Binding Idle}"
                                  AutomationProperties.Name="Use my provider API keys for titles and summaries" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Classes="frLabel" FontSize="13" Text="Use these API keys for kcap's own calls" />
                            <TextBlock Classes="frDetail">
                                <Run Text="{Binding ProviderKeyNotice}" /><Run Text="{Binding ProviderKeyDetail}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Turning a harness on also puts the bundled CLI on the login shell. -->
                <TextBlock Classes="frNote" IsVisible="{Binding PathHazard}">
                    <Run Text="Turning harnesses on also adds " /><Run Text="kcap" FontFamily="{StaticResource FrMonoFont}" /><Run Text=" to your terminal, so their hooks can run it. " /><Run Text="{Binding PathFix.Disclosure}" />
                </TextBlock>
                <Border Classes="frResolved" IsVisible="{Binding PathResolved}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <icons:AppIcon Kind="Check" Size="14" VerticalAlignment="Center" Foreground="{StaticResource KcapSuccessBrush}" />
                        <TextBlock Classes="frDetail" Foreground="{StaticResource FrMutedBrush}">
                            <Run Text="Your login shell on " /><Run Text="{Binding MachineName}" FontFamily="{StaticResource FrMonoFont}" /><Run Text=" can now find " /><Run Text="kcap" FontFamily="{StaticResource FrMonoFont}" /><Run Text=". Capture will record." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Classes="frError" Text="{Binding Message}"
                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </Border>

        <TextBlock Classes="frNote" IsVisible="{Binding DeclineVisible}"
                   Text="No new connections selected. Reopen setup from Help and support whenever you're ready." />
        <TextBlock Classes="frNote" IsVisible="{Binding ConnectionsSaved}"
                   Text="{Binding SavedNote}" />
        <TextBlock Classes="frNote" Text="Setup adds connections; it doesn't remove existing ones. Unchecking a box leaves that part of an existing connection unchanged." />
        <TextBlock Classes="frNote" IsVisible="{Binding !DeclineVisible}">
            <Run Text="Then you can ask " /><Run Text="“have I hit this before?”" Foreground="{StaticResource FrMutedBrush}" /><Run Text=" or " /><Run Text="“what did I change in the importer last week?”" Foreground="{StaticResource FrMutedBrush}" />
        </TextBlock>
    </StackPanel>
</UserControl>
