<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels.Onboarding"
             xmlns:views="clr-namespace:Capacitor.App.Views.Onboarding"
             xmlns:app="clr-namespace:Capacitor.App.Views"
             x:Class="Capacitor.App.Views.Onboarding.OnboardingPaneView"
             x:DataType="vm:OnboardingViewModel"
             Background="{StaticResource KcapCanvasBrush}">
    <UserControl.Styles>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter,
                         ComboBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="Background" Value="{StaticResource KcapBorderBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
        </Style>
    </UserControl.Styles>
    <!-- Per-step templates, selected by ViewModel type; the ContentControl below deliberately
         sets no ContentTemplate, which would win over every one of these. -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:WelcomeStepViewModel">
            <Border Classes="frCard">
                <StackPanel Spacing="14">
                    <TextBlock Classes="frMicro" Text="WHAT SETUP DOES ON THIS MACHINE" />
                    <ItemsControl x:Name="WelcomeItems" ItemsSource="{x:Static vm:WelcomeStepViewModel.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WelcomeItem">
                                <Border Classes="frRowRule" Padding="2,11">
                                    <Grid ColumnDefinitions="180,*" ColumnSpacing="14">
                                        <TextBlock Classes="frLabel" Text="{Binding Title}" />
                                        <TextBlock Grid.Column="1" Classes="frDetail" FontSize="12.5" Text="{Binding Detail}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="frNote">
                        <Run Text="Your settings live in " /><Run Text="~/.config/kcap" FontFamily="{StaticResource FrMonoFont}"
                            Foreground="{StaticResource FrMutedBrush}" /><Run Text=". Every choice can be changed later in Settings." />
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="vm:SignInStepViewModel">
            <views:SignInPaneView />
        </DataTemplate>

        <DataTemplate DataType="vm:DefaultsStepViewModel">
            <StackPanel Spacing="14">
                <Border Classes="frCard">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="frMicro" Text="NAME" />
                        <TextBlock Classes="frDetail" Text="How this machine identifies itself to the server." />
                        <TextBox x:Name="DaemonNameBox" Classes="frField" Text="{Binding DaemonName, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="DefaultsMessageText" Classes="frError" Text="{Binding Message}"
                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:HarnessesStepViewModel">
            <views:HarnessesPaneView />
        </DataTemplate>

        <DataTemplate DataType="vm:ImportStepViewModel">
            <StackPanel Spacing="14">
                <TextBlock x:Name="ImportMessageText" Text="{Binding Message}" TextWrapping="Wrap"
                           Foreground="{StaticResource KcapDangerBrush}" FontSize="12" LetterSpacing="0.2"
                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <Border Classes="frCard">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="kcapLabel" Text="Agents" />
                        <ItemsControl x:Name="ImportVendorsList" ItemsSource="{Binding Vendors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="220" ItemSpacing="8" LineSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="ImportVendorCheckBox" Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="frCard">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="kcapLabel" Text="What to import" />
                        <RadioButton x:Name="EverythingChoice" GroupName="ImportScope" Content="All sessions from those agents"
                                     IsChecked="{Binding EverythingSelected, Mode=TwoWay}" />
                        <RadioButton x:Name="OrgChoice" GroupName="ImportScope" Content="One organization"
                                     IsChecked="{Binding OrgSelected, Mode=TwoWay}" />
                        <TextBox x:Name="OrgTextBox" Classes="kcapField" PlaceholderText="acme"
                                 Text="{Binding OrgText, Mode=TwoWay}" IsVisible="{Binding OrgSelected}" />
                        <RadioButton x:Name="RepoChoice" GroupName="ImportScope" Content="One repository"
                                     IsChecked="{Binding RepoSelected, Mode=TwoWay}" />
                        <TextBox x:Name="RepoTextBox" Classes="kcapField" PlaceholderText="owner/name"
                                 Text="{Binding RepoText, Mode=TwoWay}" IsVisible="{Binding RepoSelected}" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RunImportButton" Classes="kcapPrimary" Content="Import" Command="{Binding RunCommand}" />
                    <Button x:Name="CancelImportButton" Classes="kcapChip" Content="Cancel" Command="{Binding CancelCommand}"
                            IsVisible="{Binding Busy}" />
                    <TextBlock x:Name="ImportStatusText" Classes="kcapHint" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="ImportTruncationText" Classes="kcapHint" Text="…older lines dropped" FontStyle="Italic"
                           IsVisible="{Binding Truncated}" />
                <ItemsControl x:Name="ImportLog" ItemsSource="{Binding Log}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontSize="12" LetterSpacing="0.2"
                                       Foreground="{StaticResource KcapMutedBrush}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:DaemonStepViewModel">
            <StackPanel Spacing="14">
                <Border Classes="frCard">
                    <StackPanel Spacing="14">
                        <TextBlock x:Name="DaemonMessageText" Text="{Binding Message}" TextWrapping="Wrap"
                                   FontSize="13.5" LineHeight="21" Foreground="{StaticResource KcapTextBrush}"
                                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <Button x:Name="DaemonActionButton" Classes="kcapPrimary" Content="{Binding ActionLabel}"
                                Command="{Binding ActionCommand}" HorizontalAlignment="Left"
                                IsVisible="{Binding ActionLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <Button x:Name="DaemonRefreshButton" Classes="kcapChip" Content="Check again"
                                Command="{Binding RefreshCommand}" HorizontalAlignment="Left"
                                IsVisible="{Binding RefreshVisible}" />

                        <TextBlock x:Name="DaemonStatusText" Classes="kcapHint" Text="{Binding Status}" TextWrapping="Wrap"
                                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:DoneStepViewModel">
            <StackPanel Spacing="14">
                <Border Classes="frCard">
                    <ItemsControl x:Name="SummaryList" ItemsSource="{Binding Summary}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="12,10">
                                    <Grid Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <Border CornerRadius="11" Background="{StaticResource KcapSuccessDimBrush}"
                                                IsVisible="{Binding Satisfied}" />
                                        <Border CornerRadius="11" Background="{StaticResource KcapSurfaceRaisedBrush}"
                                                BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="1"
                                                IsVisible="{Binding Incomplete}" />
                                        <TextBlock x:Name="SummaryGlyphText" Text="{Binding Glyph}" FontSize="11"
                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource KcapSuccessBrush}"
                                                   IsVisible="{Binding Satisfied}" />
                                        <TextBlock Text="–" FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource KcapMutedBrush}"
                                                   IsVisible="{Binding Incomplete}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="SummaryTitleText" Classes="kcapLabel" Text="{Binding Title}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="SummaryNoteText" Classes="kcapHint" Text="{Binding Detail}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>


    <Panel>
        <!-- The setup page's bloom: behind the column, never under the pointer. -->
        <Ellipse Width="900" Height="900" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Fill="{StaticResource FrBloomBrush}" IsHitTestVisible="False" />

        <ScrollViewer x:Name="StepScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="620" HorizontalAlignment="Center" Margin="32,72,32,56" Spacing="26">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,-8">
                    <Path Data="{x:Static views:OnboardingPaneView.Wordmark}" Fill="{StaticResource KcapTextBrush}"
                          Height="18" Stretch="Uniform" HorizontalAlignment="Left" />
                </Grid>

                <StackPanel Spacing="14">
                    <TextBlock x:Name="StepEyebrowText" Classes="frEyebrow" Text="{Binding Eyebrow}" />
                    <!-- Fallback presenter: always shows the current step's title, template or not. -->
                    <TextBlock x:Name="StepTitleText" Classes="frHeadline" Text="{Binding Current.Title}" />
                    <TextBlock x:Name="StepLedeText" Classes="frLede" Text="{Binding Current.Lede}"
                               IsVisible="{Binding Current.Lede, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <ContentControl x:Name="StepContent" Content="{Binding Current}" HorizontalAlignment="Stretch" />

                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                        <Button x:Name="NextButton" Classes="frPrimary" Command="{Binding NextCommand}"
                                Content="{Binding NextLabel, Converter={x:Static views:UpperCase.Instance}}"
                                IsVisible="{Binding NextVisible}" />
                        <Button Grid.Column="1" x:Name="SkipButton" Classes="frSecondary" Command="{Binding SkipCommand}"
                                Content="{Binding SkipLabel, Converter={x:Static views:UpperCase.Instance}}"
                                IsVisible="{Binding SkipVisible}" />
                        <Button Grid.Column="3" x:Name="BackButton" Classes="frQuiet" Content="BACK"
                                Command="{Binding BackCommand}" IsVisible="{Binding BackVisible}" />
                    </Grid>

                    <!-- The outcome consumer's lines: wizard-first mode has no tray and no rail, so this
                         is where a lane outcome actually becomes visible. -->
                    <TextBlock x:Name="LifecycleStatusText" Classes="frNote" Text="{Binding Surface.StatusText}"
                               IsVisible="{Binding Surface.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock x:Name="LifecycleAttentionText" Classes="frError" Text="{Binding Surface.AttentionText}"
                               IsVisible="{Binding Surface.AttentionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- The pane covers the window's own drag strip. -->
        <Border Height="40" VerticalAlignment="Top" Background="Transparent" PointerPressed="OnChromePointerPressed" />
    </Panel>
</UserControl>
