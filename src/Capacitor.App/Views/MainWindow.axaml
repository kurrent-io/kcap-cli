<rxui:ReactiveWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:rxui="clr-namespace:ReactiveUI.Avalonia;assembly=ReactiveUI.Avalonia"
                     xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
                     xmlns:views="clr-namespace:Capacitor.App.Views"
                     xmlns:svc="clr-namespace:Capacitor.App.Services"
                     xmlns:onboarding="clr-namespace:Capacitor.App.Views.Onboarding"
                     x:Class="Capacitor.App.Views.MainWindow"
                     x:TypeArguments="vm:MainWindowViewModel"
                     x:DataType="vm:MainWindowViewModel"
                     Title="kcap Desktop"
                     Icon="avares://kcap-desktop/Assets/kcap-icon.png"
                     Width="{x:Static svc:WindowSizeMemory.DefaultWidth}"
                     MinWidth="{x:Static svc:WindowSizeMemory.MinWidth}"
                     Height="{x:Static svc:WindowSizeMemory.DefaultHeight}"
                     MinHeight="{x:Static svc:WindowSizeMemory.MinHeight}"
                     Background="{StaticResource KcapCanvasBrush}"
                     ExtendClientAreaToDecorationsHint="True">
    <Window.KeyBindings>
        <KeyBinding Gesture="Meta+N" Command="{Binding CloseWorkspaceCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding CloseWorkspaceCommand}" />
    </Window.KeyBindings>
    <!-- Rail | launcher-or-workspace. The right pane's empty state IS the launcher.
         Workspace content is a template so the terminal is only built once a session opens.
         ExtendClientAreaToDecorationsHint paints into the title bar; the transparent strip below
         only receives presses where no surface content is hit-testable — rail and workspace
         headers carry their own drag handlers. -->
    <Panel>
        <!-- Outside the scale, so the drag strip stays the title bar's height at any zoom. -->
        <Border Height="40" VerticalAlignment="Top" Background="Transparent"
                PointerPressed="OnChromePointerPressed" />

        <LayoutTransformControl x:Name="ScaleHost">
            <Panel>
                <Grid x:Name="SessionsSurface" ColumnDefinitions="330,*">
                    <views:SessionRailView x:Name="SessionRail" Grid.Column="0" />
                    <Panel x:Name="ContentPane" Grid.Column="1">
                        <!-- The launcher pane: import status top-left, web shortcut top-right, the composer
                             centered. Visible exactly while no workspace is open. -->
                        <Grid x:Name="LauncherPane" RowDefinitions="Auto,*" Margin="24,20,24,24"
                              IsVisible="{Binding CurrentWorkspace, Converter={x:Static ObjectConverters.IsNull}}">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Background="Transparent"
                                  PointerPressed="OnChromePointerPressed">
                                <TextBlock Text="{Binding HistoryImportStatus}" IsVisible="{Binding HistoryImportVisible}"
                                           FontSize="12" Foreground="{StaticResource KcapMutedBrush}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="0,0,16,0" />
                                <!-- Daemon recovery sits in LauncherPaneView's connection banner (same
                                     place as sign-in), not here in the chrome. -->

                                <Button Grid.Column="1" x:Name="OpenWebButton" Classes="kcapChip" VerticalAlignment="Top"
                                        HorizontalAlignment="Right" Command="{Binding Web.OpenCommand}"
                                        IsVisible="{Binding Web.IsVisible, FallbackValue=False}"
                                        ToolTip.Tip="{Binding Web.Tooltip}"
                                        AutomationProperties.Name="{Binding Web.Label}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="{Binding Web.Label}" VerticalAlignment="Center" />
                                        <views:AppIcon Kind="ExternalLink" Size="14" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <views:LauncherPaneView x:Name="LauncherView" Grid.Row="1" DataContext="{Binding Home}" />
                        </Grid>

                        <ContentControl x:Name="WorkspaceHost" Content="{Binding CurrentWorkspace}"
                                        IsVisible="{Binding CurrentWorkspace, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ContentControl.DataTemplates>
                                <views:RetainedViewTemplate x:DataType="vm:WorkspaceViewModel">
                                    <views:WorkspaceView />
                                </views:RetainedViewTemplate>
                                <views:RetainedViewTemplate x:DataType="vm:RemoteSessionViewModel">
                                    <views:RemoteSessionView />
                                </views:RetainedViewTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>

                        <Border x:Name="SwitchCover" Background="{StaticResource KcapCanvasBrush}" IsVisible="False">
                            <views:StillImage x:Name="SwitchCoverStill" />
                        </Border>
                    </Panel>
                </Grid>
            </Panel>
        </LayoutTransformControl>

        <!-- Unscaled like the strip above: the pane draws its own title-bar drag area. -->
        <!-- Onboarding covers the rail and launcher until it hands over; see Onboarding. -->
        <onboarding:OnboardingPaneView x:Name="OnboardingPane" DataContext="{x:Null}" IsVisible="False" />
    </Panel>
</rxui:ReactiveWindow>
