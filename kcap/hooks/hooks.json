{
  "description": "kcap — automatic capture, search, and recall sessions",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kcap hook --claude --no-update-check",
            "timeout": 9
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kcap hook --claude --no-update-check",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kcap hook --claude --no-update-check",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kcap hook --claude --no-update-check",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "kcap hook --claude --no-update-check",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "kcap hook --claude --no-update-check",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "kcap hook --claude --plan-read --no-update-check",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "TaskCreate|TaskUpdate|TodoWrite|Agent|mcp__.*kcap-plans__.*",
        "hooks": [
          {
            "type": "command",
            "command": "kcap hook --claude --task-list --no-update-check",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*progress.md*)",
            "command": "kcap hook --claude --task-list --no-update-check",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "kcap hook --claude --task-list --no-update-check",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "kcap hook --claude --plan-edit --no-update-check",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "kcap hook --claude --no-update-check",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kcap hook --claude --no-update-check",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kcap hook --claude --no-update-check",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kcap hook --claude --no-update-check",
            "timeout": 36000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kcap hook --claude --title-prompt --no-update-check",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
